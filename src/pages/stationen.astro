---
import Layout from '../layouts/Layout.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import StationenListe from '../components/StationenListe.astro';
import Fuss from '../components/Fuss.astro';
import Lightbox from '../components/Lightbox.astro';
import { stationen, monate, ortName, slug } from '../data/stationen';

const erste = stationen.find((s) => s.fotos.length)!;
---

<Layout
	unterseite
	titel="Unsere Stationen – Fraktion Bräune"
	beschreibung="Alle Turniere der Fraktion Bräune auf der German Beach Tour, von Timmendorf 2022 bis Dortmund 2026: Fotos, Videos aus dem Block und unsere Sätze zu jedem Stopp."
	bild={erste.fotos[0].bild}
	bildAlt={erste.fotos[0].alt}
>
	<SeitenKopf
		wort="Stationen"
		eintraege={stationen.map((s) => ({ href: `#${slug(s)}`, text: `${ortName(s)}${s.zusatz ? ` ${s.zusatz}` : ''} · ${monate[s.monat - 1].slice(0, 3)}`, jahr: s.jahr }))}
	/>
	<main class="wrap seite">
		<StationenListe />
		<p class="zurueck"><a href="/">← Zurück zur Startseite</a></p>
	</main>
	<Fuss />
	<Lightbox />
</Layout>

<style>
	.seite {
		padding-top: 72px;
		padding-bottom: 96px;
	}
	.zurueck {
		margin-top: 96px;
	}
	.zurueck a {
		font-family: var(--marker);
		font-size: 1.2rem;
		color: var(--sonne);
	}
</style>
