---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import Fuss from '../components/Fuss.astro';
import Handy from '../components/Handy.astro';
import logo from '../assets/logo-bunt.png';
import { choreos, slug } from '../data/choreos';
import { grossUrl } from '../data/fotos';

const gross = new Map<string, string>();
for (const c of choreos) for (const f of c.fotos) gross.set(f.bild.src, await grossUrl(f));

const monate = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const neigungen = [-2, 1.5, -1, 2, -1.5, 1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)', 'var(--sonne)', 'var(--blau)', 'var(--glut)'];
---

<Layout
	titel="Unsere Choreos – Fraktion Bräune"
	beschreibung="Banner, Fahnen, Papptafeln und Rauch: alle Choreos der Fraktion Bräune auf der German Beach Tour, von Timmendorf 2023 bis Dortmund 2026, mit Fotos und Videos aus dem Block."
	bild={choreos[0].fotos[0].bild}
	bildAlt={choreos[0].fotos[0].alt}
>
	<header class="kopf">
		<div class="wrap">
			<a href="/" class="heim" aria-label="Zur Startseite">
				<Image src={logo} widths={[300, 600]} sizes="200px" alt="Fraktion Bräune" class="logo" />
			</a>
			<h1>Unsere <span class="bunt">{[...'Choreos'].map((c) => <span>{c}</span>)}</span></h1>
			<nav class="inhalt" aria-label="Choreos">
				{choreos.map((c) => <a href={`#${slug(c)}`}>{c.titel}</a>)}
			</nav>
		</div>
	</header>

	<main class="wrap liste">
		{choreos.map((c, i) => (
			<article id={slug(c)} class="choreo" style={`--schatten: ${farben[i % farben.length]}`}>
				<header class="info">
					<p class="wann">
						<span class="datum">{monate[c.monat - 1]} {c.jahr}</span>
						<span class="ort">{c.ort}{c.stopp && ` ${c.stopp}`}</span>
						{c.zusatz && <span class="zusatz">{c.zusatz}</span>}
					</p>
					<h2 class="titel marker">{c.titel}</h2>
					{c.vonAnderen && <p class="geschenk">💜 Nicht von uns, sondern von anderen Fans für uns</p>}
					<ul class="zutaten" role="list">
						{c.zutaten.map((z) => <li>{z}</li>)}
					</ul>
				</header>
				{/* Immer gleich: die Choreo groß, darunter weitere Fotos und Videos in einer Reihe */}
				<button
								type="button"
								class="foto haupt"
								style={`--r: ${neigungen[(i + 0) % neigungen.length]}deg`}
								data-gross={gross.get(c.fotos[0].bild.src)}
								data-alt={c.fotos[0].alt}
								data-credit={c.fotos[0].credit ?? ''}
								aria-label={`Groß anzeigen: ${c.fotos[0].alt}`}
							>
								<Picture src={c.fotos[0].bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1068px, 92vw" alt={c.fotos[0].alt} loading={i < 2 ? 'eager' : 'lazy'} />
							</button>
				{(c.fotos.length > 1 || c.clips) && (
					<div class="weitere">
						{c.fotos.slice(1).map((f, j) => (
							<button
								type="button"
								class="foto klein"
								style={`--r: ${neigungen[(i + j + 1) % neigungen.length]}deg`}
								data-gross={gross.get(f.bild.src)}
								data-alt={f.alt}
								data-credit={f.credit ?? ''}
								aria-label={`Groß anzeigen: ${f.alt}`}
							>
								<Picture src={f.bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 760px) 400px, 70vw" alt={f.alt} loading={i < 2 ? 'eager' : 'lazy'} />
							</button>
						))}
						{c.clips?.map((k, j) => <div class="handy-platz"><Handy clip={k} r={neigungen[(i + j + 2) % neigungen.length]} /></div>)}
					</div>
				)}
			</article>
		))}
		<p class="zurueck"><a href="/">← Zurück zur Startseite</a></p>
	</main>

	<Fuss />
	<Lightbox />
</Layout>

<style>
	.kopf {
		padding: 32px 0 56px;
		background:
			radial-gradient(ellipse at 20% 0%, rgb(255 46 77 / 0.2), transparent 55%),
			radial-gradient(ellipse at 90% 30%, rgb(47 212 122 / 0.14), transparent 50%),
			var(--nacht);
	}
	.heim {
		display: inline-block;
	}
	.logo {
		width: 180px;
		height: auto;
		filter: drop-shadow(3px 4px 0 var(--tinte));
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.heim:hover .logo {
		transform: rotate(-3deg) scale(1.05);
	}
	h1 {
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(3.2rem, 12vw, 7rem);
		line-height: 0.95;
		margin: 40px 0 28px;
	}
	.inhalt {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.inhalt a {
		font-size: 0.9rem;
		font-weight: 700;
		padding: 0.35em 0.9em;
		border-radius: 999px;
		border: 2px solid rgb(248 242 231 / 0.3);
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}
	.inhalt a:hover {
		background: var(--papier);
		color: var(--tinte);
	}

	.liste {
		display: grid;
		gap: clamp(80px, 12vw, 140px);
		padding-top: 72px;
		padding-bottom: 96px;
	}
	/* Leserichtung: oben Titel, darunter Fotos und Handys in einer Reihe */
	.choreo {
		display: grid;
		gap: 32px;
		scroll-margin-top: 32px;
	}
	/* Hauptfoto der Choreo über die ganze Breite, nicht höher als der Bildschirm */
	.foto.haupt {
		display: block;
		/* groß nur leicht schräg, sonst kippt die ganze Seite */
		transform: rotate(calc(var(--r) * 0.35));
	}
	.foto.haupt :global(img) {
		max-height: 78vh;
	}
	/* Weitere Fotos und Videos: eine Reihe gleich hoher Kacheln, auf dem Handy zum Wischen */
	.weitere {
		--hoehe: clamp(220px, 26vw, 300px);
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 24px;
	}
	.foto.klein :global(img) {
		height: var(--hoehe);
		width: auto;
		max-width: 100%;
	}
	.handy-platz {
		width: calc(var(--hoehe) * 0.6);
		flex: none;
	}
	@media (max-width: 759px) {
		.weitere {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			margin: 0 -16px;
			padding: 8px 16px 16px;
		}
		.weitere > * {
			flex: none;
			scroll-snap-align: center;
		}
	}
	.foto {
		all: unset;
		box-sizing: border-box;
		cursor: zoom-in;
		padding: 10px;
		background: var(--papier);
		box-shadow: 0 16px 36px rgb(0 0 0 / 0.5);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.foto:hover,
	.foto:focus-visible {
		transform: rotate(0) scale(1.04);
		z-index: 1;
	}
	.foto:focus-visible {
		outline: 3px solid var(--sonne);
	}
	.foto :global(img) {
		width: 100%;
		height: auto;
		max-height: 64vh;
		object-fit: cover;
		display: block;
	}
	/* Wann und wo: groß in der Plakatschrift, Stopp bzw. Turnierart als Etikett */
	.wann {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 14px;
		font-family: var(--display);
		text-transform: uppercase;
		line-height: 1.05;
	}
	.datum {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		color: var(--sonne);
	}
	.ort {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
	}
	.zusatz {
		align-self: center;
		padding: 0.15em 0.55em;
		background: var(--sonne);
		color: var(--tinte);
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		letter-spacing: 0.04em;
		transform: rotate(-3deg);
	}
	.titel {
		display: inline-block;
		margin: 14px 0 0;
		padding: 0.3em 0.7em;
		background: var(--papier);
		color: var(--tinte);
		font-weight: 400;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.15;
		transform: rotate(-2deg);
		box-shadow: 6px 6px 0 var(--schatten);
	}
	.geschenk {
		margin: 18px 0 0;
		font-weight: 800;
		color: var(--lila);
	}
	.zutaten {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.zutaten li {
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.3em 0.8em;
		border-radius: 999px;
		background: rgb(248 242 231 / 0.1);
		border: 1px solid rgb(248 242 231 / 0.25);
	}
	.zurueck a {
		font-family: var(--marker);
		font-size: 1.2rem;
		color: var(--sonne);
	}
</style>
