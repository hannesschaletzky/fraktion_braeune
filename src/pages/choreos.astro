---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import Fuss from '../components/Fuss.astro';
import Handy from '../components/Handy.astro';
import { choreos, slug } from '../data/choreos';
import SeitenKopf from '../components/SeitenKopf.astro';
import { grossUrl } from '../data/fotos';

const gross = new Map<string, string>();
for (const c of choreos) for (const f of c.fotos) gross.set(f.bild.src, await grossUrl(f));

const monate = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const neigungen = [-2, 1.5, -1, 2, -1.5, 1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)', 'var(--sonne)', 'var(--blau)', 'var(--glut)'];
---

<Layout
	unterseite
	titel="Unsere Choreos – Fraktion Bräune"
	beschreibung="Banner, Fahnen, Papptafeln und Rauch: alle Choreos der Fraktion Bräune auf der German Beach Tour, von Timmendorf 2023 bis Dortmund 2026, mit Fotos und Videos aus dem Block."
>
	<SeitenKopf wort="Choreos" eintraege={choreos.map((c) => ({ href: `#${slug(c)}`, text: c.titel, jahr: c.jahr }))} />

	<main class="wrap liste">
		{choreos.map((c, i) => (
			<article id={slug(c)} class="choreo" data-eintrag data-jahr={c.jahr} style={`--schatten: ${farben[i % farben.length]}`}>
				<header class="info">
					<p class="wann">
						<span class="datum">{c.jahr}<span class="strich" aria-hidden="true">|</span><span class="monat">{monate[c.monat - 1].slice(0, 3)}</span><span class="strich" aria-hidden="true">|</span></span>
						<span class="ort">{c.ort}{c.stopp && ` ${c.stopp}`}</span>
						{c.zusatz && <span class="zusatz">{c.zusatz}</span>}
					</p>
					<h2 class="titel marker">{c.titel}</h2>
					{c.vonAnderen && <p class="geschenk">💜 Nicht von uns, sondern von anderen Fans für uns</p>}
					{c.hinweis && <p class="hinweis">{c.hinweis}</p>}
				</header>
				{/* Immer gleich: die Choreo groß, darunter eine Reihe Fotos und eine Reihe Videos */}
				<button
								type="button"
								class="foto haupt"
								style={`--r: ${neigungen[(i + 0) % neigungen.length]}deg`}
								data-gross={gross.get(c.fotos[0].bild.src)}
								data-alt={c.fotos[0].alt}
								data-credit={c.fotos[0].credit ?? ''}
								aria-label={`Groß anzeigen: ${c.fotos[0].alt}`}
							>
								<Picture src={c.fotos[0].bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1068px, 92vw" alt={c.fotos[0].alt} loading={i < 2 ? 'eager' : 'lazy'} />
							</button>
				{c.fotos.length > 1 && (
					<div class="weitere">
						{c.fotos.slice(1).map((f, j) => (
							<button
								type="button"
								class="foto klein"
								style={`--r: ${neigungen[(i + j + 1) % neigungen.length]}deg`}
								data-gross={gross.get(f.bild.src)}
								data-alt={f.alt}
								data-credit={f.credit ?? ''}
								aria-label={`Groß anzeigen: ${f.alt}`}
							>
								<Picture src={f.bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 760px) 400px, 70vw" alt={f.alt} loading={i < 2 ? 'eager' : 'lazy'} />
							</button>
						))}
					</div>
				)}
				{c.clips && (
					<div class="weitere">
						{c.clips.map((k, j) => <div class="handy-platz"><Handy clip={k} r={neigungen[(i + j + 2) % neigungen.length]} /></div>)}
					</div>
				)}
			</article>
		))}
		<p class="zurueck"><a href="/">← Zurück zur Startseite</a></p>
	</main>

	<Fuss />
	<Lightbox />
</Layout>


<style>
	.liste {
		display: grid;
		gap: clamp(80px, 12vw, 140px);
		padding-top: 72px;
		padding-bottom: 96px;
	}
	/* Leserichtung: oben Titel, darunter Fotos und Handys in einer Reihe */
	.choreo {
		display: grid;
		gap: 32px;
		scroll-margin-top: 32px;
	}
	/* Hauptfoto der Choreo über die ganze Breite, nicht höher als der Bildschirm */
	/* Ganzes Foto zeigen, nie zuschneiden (sonst fällt das Banner am Rand weg); Hochformate werden schmaler */
	.foto.haupt {
		display: block;
		width: fit-content;
		max-width: 100%;
		/* groß nur leicht schräg, sonst kippt die ganze Seite */
		transform: rotate(calc(var(--r) * 0.35));
	}
	.foto.haupt :global(img) {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 78vh;
		object-fit: contain;
	}
	/* Weitere Fotos, darunter die Videos: je eine Reihe gleich hoher Kacheln. Passt eine Reihe nicht in die Breite,
	   scrollt sie seitlich (auf dem Handy mit Einrasten). Innenabstand, damit gekippte Karten und Schatten nicht abgeschnitten werden. */
	.weitere {
		--hoehe: clamp(220px, 26vw, 300px);
		display: flex;
		flex-wrap: nowrap;
		align-items: flex-start;
		gap: 24px;
		overflow-x: auto;
		margin: -14px -16px;
		padding: 14px 16px 22px;
		scroll-snap-type: x proximity;
	}
	.weitere > * {
		flex: none;
		scroll-snap-align: start;
	}
	.foto.klein :global(img) {
		height: var(--hoehe);
		width: auto;
		max-width: 100%;
	}
	.handy-platz {
		width: calc(var(--hoehe) * 0.6);
		flex: none;
	}
	/* Quer gedrehtes Handy: gleiche Höhe, entsprechend breiter */
	.handy-platz:has(:global(.handy.quer)) {
		width: calc(var(--hoehe) * 1.7);
	}
	@media (max-width: 759px) {
		.weitere {
			scroll-snap-type: x mandatory;
		}
		/* Ausrichten links, damit rechts schon das nächste Foto hervorschaut */
		.weitere > * {
			scroll-snap-align: start;
		}
		/* Querformat-Fotos nicht bildschirmbreit: rechts schaut das nächste Foto hervor, man sieht, dass es weitergeht */
		.foto.klein {
			max-width: 78vw;
		}
		.foto.klein :global(img) {
			height: calc(var(--hoehe) * 0.92);
		}
	}
	.foto {
		all: unset;
		box-sizing: border-box;
		cursor: zoom-in;
		padding: 10px;
		background: var(--papier);
		box-shadow: 0 16px 36px rgb(0 0 0 / 0.5);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.foto:hover,
	.foto:focus-visible {
		transform: rotate(0) scale(1.04);
		z-index: 1;
	}
	.foto:focus-visible {
		outline: 3px solid var(--sonne);
	}
	.foto :global(img) {
		width: 100%;
		height: auto;
		max-height: 64vh;
		object-fit: cover;
		display: block;
	}
	/* Wann und wo: groß in der Plakatschrift, Stopp bzw. Turnierart als Etikett */
	.wann {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 14px;
		font-family: var(--display);
		text-transform: uppercase;
		line-height: 1.05;
	}
	/* Jahr | Monat (drei Buchstaben) | Ort; Datum weiß, Ort gelb */
	.datum {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		font-variant-numeric: tabular-nums;
	}
	/* Dezente Striche zwischen Jahr, Monat und Ort */
	.strich {
		margin: 0 0.35em;
		opacity: 0.35;
	}
	/* Nach dem letzten Strich sorgt schon der Abstand der Zeile für Luft */
	.strich:last-child {
		margin-right: 0;
	}
	/* Der Tourstopp ist das Wichtigste: gelb */
	.ort {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		color: var(--sonne);
	}
	.zusatz {
		align-self: center;
		padding: 0.15em 0.55em;
		border: 2px solid var(--sonne);
		color: var(--sonne);
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		letter-spacing: 0.04em;
		transform: rotate(-3deg);
	}
	.titel {
		display: inline-block;
		margin: 14px 0 0;
		padding: 0.3em 0.7em;
		background: var(--papier);
		color: var(--tinte);
		font-weight: 400;
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.15;
		transform: rotate(-2deg);
		box-shadow: 6px 6px 0 var(--schatten);
	}
	.geschenk {
		margin: 18px 0 0;
		font-weight: 800;
		color: var(--lila);
	}
	.hinweis {
		margin: 18px 0 0;
		max-width: 60ch;
		font-size: 0.95rem;
		opacity: 0.7;
	}
	.zurueck a {
		font-family: var(--marker);
		font-size: 1.2rem;
		color: var(--sonne);
	}
</style>
