---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WerWirSind from '../components/WerWirSind.astro';
import ChoreoWand from '../components/ChoreoWand.astro';
import Chronik from '../components/Chronik.astro';
import TvMomente from '../components/TvMomente.astro';
import Stimmen from '../components/Stimmen.astro';
import Zwischenbild from '../components/Zwischenbild.astro';
import Faq from '../components/Faq.astro';
import Fuss from '../components/Fuss.astro';
import fackel from '../assets/fotos/zwischen-fackel.jpg';
import r2 from '../assets/fotos/zwischen-r2.jpg';
import r4 from '../assets/fotos/zwischen-r4.jpg';
import s2 from '../assets/fotos/zwischen-s2.jpg';
import Lightbox from '../components/Lightbox.astro';
---

<Layout>
	<Hero />
	<main>
		<WerWirSind />
		<Stimmen />
		<Zwischenbild bild={s2} bildHandy={r4} alt="München 2026: die ganze Tribüne glüht rot, mittendrin reckt einer eine Fackel hoch" pos="50% 50%" posHandy="50% 50%" versatz="-16%" versatzHandy="8%" oben="var(--nacht-2)" unten="var(--nacht)" />
		<TvMomente />
		<ChoreoWand />
		<Zwischenbild bild={r2} bildHandy={fackel} alt="Der Block bei Nacht: einer reckt eine rote Fackel in die Höhe, ringsum jubeln alle" pos="50% 0%" posHandy="38% 50%" versatz="13%" versatzHandy="0%" oben="var(--nacht-2)" unten="var(--nacht)" />
		<Chronik />
		<Faq />
	</main>
	<Fuss oben="var(--nacht-2)" />
	<Lightbox />
</Layout>
