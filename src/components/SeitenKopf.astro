---
// Kopf der Unterseiten (Choreos, Stationen): große Überschrift, Jahres-Filter, Pillen zu den Einträgen.
// Der Filter blendet Pillen und alle Elemente mit data-eintrag und passendem data-jahr aus.

interface Props {
	/** Bunt geschriebenes Wort nach "Unsere" */
	wort: string;
	eintraege: { href: string; text: string; jahr: number }[];
}
const { wort, eintraege } = Astro.props;
const jahre = [...new Set(eintraege.map((e) => e.jahr))].sort((a, b) => b - a);
---

<header class="kopf">
	<div class="wrap">
		<h1>Unsere <span class="bunt">{[...wort].map((c) => <span>{c}</span>)}</span></h1>
		<div class="filter" role="group" aria-label="Nach Jahr filtern">
			<button type="button" data-jahr="alle" aria-pressed="true">Alle</button>
			{jahre.map((j) => <button type="button" data-jahr={j} aria-pressed="false">{j}</button>)}
		</div>
		<nav class="inhalt" aria-label={wort}>
			{eintraege.map((e) => (
				<a href={e.href} data-jahr={e.jahr}>
					<span class="kurzjahr" aria-label={String(e.jahr)}>’{String(e.jahr).slice(2)}</span>{e.text}
				</a>
			))}
		</nav>
	</div>
</header>

<script>
	const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('.kopf .filter button')];
	const ziele = [...document.querySelectorAll<HTMLElement>('.kopf .inhalt a[data-jahr], [data-eintrag][data-jahr]')];
	knoepfe.forEach((k) =>
		k.addEventListener('click', () => {
			const jahr = k.dataset.jahr!;
			knoepfe.forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
			ziele.forEach((e) => (e.hidden = jahr !== 'alle' && e.dataset.jahr !== jahr));
		}),
	);
</script>

<style>
	.kopf {
		/* Platz für die feste Kopfleiste (56 px) */
		padding: 96px 0 56px;
		background:
			radial-gradient(ellipse at 20% 0%, rgb(255 46 77 / 0.2), transparent 55%),
			radial-gradient(ellipse at 90% 30%, rgb(47 212 122 / 0.14), transparent 50%),
			var(--nacht);
	}
	h1 {
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(3.2rem, 12vw, 7rem);
		line-height: 0.95;
		margin: 0 0 28px;
	}
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 18px;
	}
	.filter button {
		padding: 0.35em 1em;
		border-radius: 999px;
		border: 2px solid var(--sonne);
		background: transparent;
		color: var(--sonne);
		font-family: var(--display);
		font-size: 1.05rem;
		letter-spacing: 0.03em;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.filter button:hover,
	.filter button[aria-pressed='true'] {
		background: var(--sonne);
		color: var(--tinte);
	}
	.inhalt {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.inhalt a {
		font-size: 0.9rem;
		font-weight: 700;
		padding: 0.35em 0.9em;
		border-radius: 999px;
		border: 2px solid rgb(248 242 231 / 0.3);
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}
	.inhalt a:hover {
		background: var(--papier);
		color: var(--tinte);
	}
	/* Jahr vorne, damit man beim Überfliegen vergleichen kann */
	.kurzjahr {
		margin-right: 0.5em;
		font-variant-numeric: tabular-nums;
		font-size: 0.85em;
		font-weight: 800;
		color: var(--sonne);
	}
	:global([data-jahr][hidden]) {
		display: none !important;
	}
</style>
