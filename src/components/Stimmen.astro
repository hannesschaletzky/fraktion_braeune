---
// Was im Livestream über uns gesagt wurde. Ein Klick schaltet den Fernseher auf den Mitschnitt (mit Ton).
import DatumZeile from './DatumZeile.astro';
import Siegel from './Siegel.astro';
import { sender, stimmen } from '../data/clips';

// Jede Blase eine eigene Farbe (MVP lila, Riesenbanner grün, Eltern blau, …). Kommen mehr Zitate dazu als Farben,
// meldet der Build einen Fehler, statt eine Farbe doppelt zu vergeben.
const farben = ['var(--lila)', 'var(--gruen)', 'var(--blau)', 'var(--fackel)', 'var(--sonne)', 'var(--glut)', 'var(--pink)', 'var(--sand)'];
if (stimmen.length > farben.length) throw new Error(`Stimmen: ${stimmen.length} Zitate, aber nur ${farben.length} Farben`);
const neigung = [-2, 1.5, -1, 2, -1.5, 1];
const kanal = (name: string) => String(sender.findIndex((s) => s.name === name) + 1).padStart(2, '0');
// Datum und Ort kommen vom Sender, damit sie überall gleich sind
const vom = (name: string) => sender.find((s) => s.name === name)!;
// Zuerst nur so viele Zitate (Handy 3, ab Tablet 4), danach schaut die nächste Reihe verblasst hervor
// und ein Knopf klappt den Rest auf. Die Zahlen stehen auch im CSS unten (nth-child).
const klappbar = stimmen.length > 3;
---

<section class="abschnitt stimmen" id="stimmen">
	<div class="wrap">
		<h2>Was über uns <span class="bunt">{[...'gesagt'].map((c) => <span>{c}</span>)}</span> wird</h2>
		<ul class="blasen" role="list" id="stimmen-liste">
			{stimmen.map((s, i) => (
				<li style={`--farbe: ${farben[i % farben.length]}; --r: ${neigung[i % neigung.length]}deg`} >
					<blockquote>
						<p>„{s.text}“</p>
					</blockquote>
					<div class="fuss">
						<button type="button" class="hoeren" data-sender={s.sender}>📺 Ausschnitt {Number(kanal(s.sender))}</button>
						{vom(s.sender).anbieter && <Siegel anbieter={vom(s.sender).anbieter!} />}
						<DatumZeile class="datum" jahr={vom(s.sender).jahr} monat={vom(s.sender).monat} ort={vom(s.sender).ort} />
					</div>
				</li>
			))}
		</ul>
		{klappbar && (
			<button type="button" class="aufklappen" aria-expanded="false" aria-controls="stimmen-liste" data-zu={`Alle ${stimmen.length} Stimmen zeigen ↓`} data-auf="Weniger zeigen ↑">
				Alle {stimmen.length} Stimmen zeigen ↓
			</button>
		)}
	</div>
</section>

<script>
	const liste = document.querySelector<HTMLElement>('#stimmen-liste');
	const klapp = document.querySelector<HTMLButtonElement>('.stimmen .aufklappen');
	const breit = matchMedia('(min-width: 760px)');
	// Zugeklappte und angeschnittene Zitate sind weder klick- noch per Tastatur erreichbar
	const sperren = () => {
		const offen = liste?.classList.contains('offen') ?? true;
		const sichtbar = breit.matches ? 4 : 3;
		liste?.querySelectorAll<HTMLElement>(':scope > li').forEach((li, i) => (li.inert = !offen && i >= sichtbar));
	};
	if (klapp) {
		sperren();
		breit.addEventListener('change', sperren);
	}
	klapp?.addEventListener('click', () => {
		const offen = klapp.getAttribute('aria-expanded') !== 'true';
		klapp.setAttribute('aria-expanded', String(offen));
		klapp.textContent = (offen ? klapp.dataset.auf : klapp.dataset.zu) ?? '';
		liste?.classList.toggle('offen', offen);
		sperren();
		// Beim Zuklappen zurück zum Anfang des Abschnitts, sonst steht man mitten in der nächsten Sektion
		if (!offen) document.querySelector('#stimmen')?.scrollIntoView({ block: 'start' });
	});
	document.querySelectorAll<HTMLButtonElement>('.stimmen .hoeren').forEach((b) =>
		b.addEventListener('click', () => document.dispatchEvent(new CustomEvent('fb:sender', { detail: b.dataset.sender }))),
	);
</script>

<style>
	/* Hintergrund wechselt von Abschnitt zu Abschnitt: hier der hellere */
	.stimmen {
		background:
			radial-gradient(ellipse at 15% 0%, rgb(255 210 63 / 0.1), transparent 55%),
			var(--nacht-2);
	}
	.blasen {
		list-style: none;
		padding: 0;
		margin: 48px 0 0;
		display: grid;
		gap: 40px 32px;
	}
	@media (min-width: 760px) {
		.blasen {
			grid-template-columns: 1fr 1fr;
		}
	}
	li {
		transform: rotate(var(--r));
	}
	blockquote {
		position: relative;
		margin: 0;
		padding: 22px 24px;
		border-radius: 26px;
		background: var(--farbe);
		color: var(--tinte);
		border: 3px solid var(--tinte);
		box-shadow: 6px 6px 0 var(--tinte);
	}
	/* Sprechblasen-Zipfel */
	blockquote::after {
		content: '';
		position: absolute;
		left: 36px;
		bottom: -22px;
		width: 30px;
		height: 22px;
		background: var(--farbe);
		border: 3px solid var(--tinte);
		border-top: 0;
		clip-path: polygon(0 0, 100% 0, 0 100%);
	}
	blockquote p {
		margin: 0;
		font-family: var(--marker);
		font-size: clamp(1.15rem, 2.4vw, 1.4rem);
		line-height: 1.35;
	}
	/* Unter der Blase eine Zeile: links der Ausschnitt-Knopf (ggf. Siegel des Senders), rechts grau Jahr | Monat | Ort */
	/* Knopf direkt rechts neben dem Sprechblasen-Zipfel (sitzt bei 36–66 px) */
	.fuss {
		margin: 14px 0 0 80px;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	/* Datum dicht unter der Blase oben rechts, nicht auf Höhe der Knopfmitte */
	.fuss :global(.datum) {
		align-self: flex-start;
		flex: none;
		margin: -2px 14px 0 auto;
		font-size: 0.85rem;
		opacity: 0.55;
	}
	@media (max-width: 459px) {
		.fuss {
			margin-left: 62px;
			gap: 8px;
		}
		.fuss .hoeren {
			padding: 0.4em 0.8em;
			font-size: 0.9rem;
		}
		.fuss :global(.datum) {
			margin-right: 4px;
			font-size: 0.8rem;
		}
	}
	.hoeren {
		flex: none;
		padding: 0.45em 1em;
		border-radius: 999px;
		border: 2px solid var(--papier);
		background: transparent;
		color: var(--papier);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.hoeren:hover {
		background: var(--papier);
		color: var(--tinte);
	}

	/* Zugeklappt: am Handy 3 Zitate und das vierte schaut verblassend hervor, ab Tablet 4 und die nächsten zwei */
	.blasen:not(.offen) > li:nth-child(n + 5) {
		display: none;
	}
	.blasen:not(.offen) > li:nth-child(4) {
		max-height: 120px;
		overflow: hidden;
		mask-image: linear-gradient(#000 10%, transparent 95%);
		pointer-events: none;
	}
	@media (min-width: 760px) {
		.blasen:not(.offen) > li:nth-child(4) {
			max-height: none;
			overflow: visible;
			mask-image: none;
			pointer-events: auto;
		}
		.blasen:not(.offen) > li:is(:nth-child(5), :nth-child(6)) {
			display: block;
			max-height: 120px;
			overflow: hidden;
			mask-image: linear-gradient(#000 10%, transparent 95%);
			pointer-events: none;
		}
	}
	.aufklappen {
		display: block;
		margin: 8px auto 0;
		padding: 0.6em 1.4em;
		border-radius: 999px;
		border: 2px solid var(--sonne);
		background: var(--sonne);
		color: var(--tinte);
		font-family: var(--display);
		font-size: 1.15rem;
		letter-spacing: 0.03em;
		cursor: pointer;
		transition: transform 0.2s;
	}
	.aufklappen:hover {
		transform: scale(1.05);
	}
	.blasen.offen + .aufklappen {
		margin-top: 48px;
		background: transparent;
		color: var(--sonne);
	}
</style>
