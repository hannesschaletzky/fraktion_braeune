---
import { Image, getImage } from 'astro:assets';
import foto from '../assets/hero-muenchen.jpg';
import logo from '../assets/logo-bunt.png';
import m2 from '../assets/hero-handy/M2.jpg';
import m3 from '../assets/hero-handy/M3.jpg';
import p7 from '../assets/hero-handy/P7.jpg';
import q8 from '../assets/hero-handy/Q8.jpg';
import n5 from '../assets/hero-handy/N5.jpg';
import n6 from '../assets/hero-handy/N6.jpg';
import d4 from '../assets/hero-rechner/D4.jpg';
import e10 from '../assets/hero-rechner/E10.jpg';
import d7 from '../assets/hero-rechner/D7.jpg';
import d11 from '../assets/hero-rechner/D11.jpg';
import d5 from '../assets/hero-rechner/D5.jpg';

// Feste Reihenfolge: wer zum ersten Mal kommt, sieht das erste Foto; danach pro Besuch das nächste (siehe Skript unten).
// Rechner (Querformat) und Handy (Hochformat) haben je sechs Fotos und denselben Zähler.
// Pro Foto: Abstand des Schriftzugs oben, Bildausschnitt, und ob Banner + Untertitel (banner) bzw. nur der Untertitel (claim)
// nach unten über den Fackel-Hinweis wandern. posKurz: Ausschnitt für flache Laptop-Fenster.
const rechnerRoh = [
	{ bild: foto, oben: 'clamp(90px, 14vh, 170px)', pos: '50% 60%', posKurz: '50% 30%', teilen: '' },
	{ bild: d4, oben: '6vh', pos: '50% 50%', teilen: 'banner' },
	{ bild: d7, oben: '5vh', pos: '50% 50%', teilen: 'banner' },
	{ bild: d11, oben: '6vh', pos: '50% 50%', teilen: 'banner' },
	{ bild: d5, oben: '7vh', pos: '50% 50%', teilen: 'banner' },
	{ bild: e10, oben: '5vh', pos: '50% 50%', teilen: 'banner' },
];
const handyRoh = [
	{ bild: n6, oben: '60px', pos: '72% 50%', teilen: 'banner' },
	{ bild: m2, oben: '60px', pos: '40% 50%', teilen: 'claim' },
	{ bild: m3, oben: '29svh', pos: '50% 50%', teilen: 'claim' },
	{ bild: p7, oben: '60px', pos: '75% 50%', teilen: 'banner' },
	{ bild: q8, oben: '60px', pos: '50% 50%', teilen: '' },
	{ bild: n5, oben: '60px', pos: '55% 50%', teilen: 'banner' },
];
// Je Foto AVIF und WebP in mehreren Breiten; das Skript baut daraus beim Laden ein einziges <picture>
const aufbereiten = (liste: typeof handyRoh, breiten: number[]) =>
	Promise.all(
		liste.map(async ({ bild, ...rest }) => {
			const w = breiten.filter((b) => b <= bild.width);
			const [a, b] = await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src: bild, widths: w, format })));
			return { ...rest, avif: a.srcSet.attribute, webp: b.srcSet.attribute, src: b.src };
		}),
	);
const [rechner, handy] = await Promise.all([aufbereiten(rechnerRoh, [960, 1440, 1920, 2400]), aufbereiten(handyRoh, [640, 1080])]);
const handyFormat = '(max-aspect-ratio: 4 / 5)';
const laptopFormat = '(min-aspect-ratio: 16 / 10) and (max-height: 820px)';
---

<header class="hero" id="hero">
	<!-- Vor dem ersten Zeichnen das Foto wählen (nur dieses wird geladen): erster Besuch das erste, danach jeweils das nächste -->
	<script is:inline define:vars={{ rechner, handy, handyFormat, laptopFormat }}>
		let i;
		try {
			const alt = localStorage.getItem('fb-hero');
			if (alt !== null && Number.isInteger(Number(alt))) i = (Number(alt) + 1) % handy.length;
		} catch {}
		if (!Number.isInteger(i)) i = 0;
		try {
			localStorage.setItem('fb-hero', String(i));
		} catch {}
		const liste = matchMedia(handyFormat).matches ? handy : rechner;
		const v = liste[i % liste.length];
		const r = document.documentElement;
		r.style.setProperty('--hero-oben', v.oben);
		if (v.teilen) r.dataset.heroTeilen = v.teilen;
		// Das Foto als echtes Bild mit höchster Priorität einsetzen; Schriftzug & Co. warten, bis es da ist (höchstens 4 s)
		const bild = document.createElement('img');
		bild.className = 'hero-bild';
		bild.alt = 'Fraktion Bräune im Block bei der German Beach Tour: Fackeln, Fahnen und Jubel';
		bild.fetchPriority = 'high';
		bild.style.objectPosition = v.posKurz && matchMedia(laptopFormat).matches ? v.posKurz : v.pos;
		const pic = document.createElement('picture');
		for (const [typ, satz] of [['image/avif', v.avif], ['image/webp', v.webp]]) {
			const q = document.createElement('source');
			q.type = typ;
			q.srcset = satz;
			q.sizes = '100vw';
			pic.append(q);
		}
		bild.src = v.src;
		pic.append(bild);
		r.classList.add('hero-wartet');
		const zeigen = () => r.classList.remove('hero-wartet');
		bild.addEventListener('load', zeigen);
		bild.addEventListener('error', zeigen);
		setTimeout(zeigen, 4000);
		document.currentScript.after(pic);
	</script>
	<div class="verlauf" aria-hidden="true"></div>
	<canvas class="rauch" id="rauch" aria-hidden="true"></canvas>

	<div class="inhalt">
		<h1>
			<Image src={logo} widths={[500, 900, 1400, 2000]} sizes="(min-width: 900px) 760px, 88vw" alt="Fraktion Bräune" class="logo" loading="eager" />
		</h1>
		<p class="banner marker">Der Support endet nie … 🫶</p>
		<p class="claim">Europas lauteste Beachvolleyball&#8209;Fans</p>
	</div>

	<p class="tipp marker" id="tipp">Tipp ins Bild und zünde eine Fackel 🔥</p>
	<a class="runter" href="#wir" aria-label="Weiter nach unten">↓</a>
</header>

<script>
	import { ruhigGewuenscht } from '../scripts/bewegung';

	type RGB = [number, number, number];
	const FARBEN: RGB[] = [
		[255, 70, 80], // rot
		[60, 210, 120], // grün
		[170, 100, 255], // lila
		[255, 215, 70], // gelb
		[70, 140, 255], // blau
		[255, 110, 170], // pink
	];
	const ROT: RGB = [255, 70, 80];

	interface Rauch { x: number; y: number; vx: number; vy: number; s: number; ds: number; a: number; da: number; bild: HTMLCanvasElement }
	interface Funke { x: number; y: number; vx: number; vy: number; leben: number }
	interface Fackel { x: number; y: number; farbe: RGB; leben: number; fest: boolean }

	// Bei "Bewegung reduzieren" bewegt sich nichts von selbst (keine Dauer-Fackeln, keine Rauchfahne der Maus).
	// Eine Fackel, die man selbst antippt, zündet trotzdem: bewusste Aktion, die nach ein paar Sekunden ausgeht.
	const ruhig = ruhigGewuenscht();

	const hero = document.getElementById('hero')!;
	const canvas = document.getElementById('rauch') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	const tipp = document.getElementById('tipp')!;

	const sprites = new Map<string, HTMLCanvasElement>();
	function sprite([r, g, b]: RGB) {
		const key = `${r},${g},${b}`;
		let c = sprites.get(key);
		if (c) return c;
		c = document.createElement('canvas');
		c.width = c.height = 64;
		const x = c.getContext('2d')!;
		const gr = x.createRadialGradient(32, 32, 0, 32, 32, 32);
		gr.addColorStop(0, `rgba(${r},${g},${b},1)`);
		gr.addColorStop(0.5, `rgba(${r},${g},${b},0.4)`);
		gr.addColorStop(1, `rgba(${r},${g},${b},0)`);
		x.fillStyle = gr;
		x.fillRect(0, 0, 64, 64);
		sprites.set(key, c);
		return c;
	}
	const glut = sprite([255, 230, 170]);

	let w = 0, h = 0;
	function groesse() {
		const dpr = Math.min(devicePixelRatio || 1, 1.5);
		w = hero.clientWidth;
		h = hero.clientHeight;
		canvas.width = w * dpr;
		canvas.height = h * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		fackeln.filter((f) => f.fest).forEach((f, i) => {
			f.x = i === 0 ? w * 0.08 : w * 0.92;
			f.y = h - 30;
		});
	}

	let rauch: Rauch[] = [];
	let funken: Funke[] = [];
	const fackeln: Fackel[] = ruhig
		? []
		: [
				{ x: 0, y: 0, farbe: ROT, leben: Infinity, fest: true },
				{ x: 0, y: 0, farbe: ROT, leben: Infinity, fest: true },
			];
	const aktiv = () => fackeln.length + rauch.length + funken.length > 0;
	let farbIndex = 0;
	let t = 0;

	function qualm(x: number, y: number, farbe: RGB, staerke = 1) {
		if (rauch.length > 700) return;
		rauch.push({
			x: x + (Math.random() - 0.5) * 8,
			y,
			vx: (Math.random() - 0.5) * 0.9,
			vy: -(0.7 + Math.random() * 1.3),
			s: 18 + Math.random() * 22,
			ds: 0.55 + Math.random() * 0.6,
			a: 0.32 * staerke,
			da: 0.0028 + Math.random() * 0.0025,
			bild: sprite(farbe),
		});
	}

	function zuenden(x: number, y: number) {
		const farbe = FARBEN[farbIndex++ % FARBEN.length];
		fackeln.push({ x, y, farbe, leben: 220, fest: false });
		const lose = fackeln.filter((f) => !f.fest);
		if (lose.length > 6) fackeln.splice(fackeln.indexOf(lose[0]), 1);
		for (let i = 0; i < 30; i++) {
			const winkel = Math.random() * Math.PI * 2;
			const v = 2 + Math.random() * 5;
			funken.push({ x, y, vx: Math.cos(winkel) * v, vy: Math.sin(winkel) * v - 2, leben: 30 + Math.random() * 30 });
		}
		tipp.classList.add('weg');
		steuern();
	}

	function schritt() {
		t++;
		const wind = Math.sin(t / 240) * 0.25 + 0.15;
		ctx.clearRect(0, 0, w, h);

		for (const f of fackeln) {
			if (Math.random() < (f.fest ? 0.55 : 0.9)) qualm(f.x, f.y, f.farbe, f.fest ? 0.9 : 1);
			if (!f.fest && Math.random() < 0.7) {
				funken.push({ x: f.x, y: f.y, vx: (Math.random() - 0.5) * 3, vy: -(1 + Math.random() * 3), leben: 20 + Math.random() * 25 });
			}
			f.leben--;
		}
		for (let i = fackeln.length - 1; i >= 0; i--) if (fackeln[i].leben <= 0) fackeln.splice(i, 1);

		ctx.globalCompositeOperation = 'source-over';
		for (const r of rauch) {
			r.vx += wind * 0.01;
			r.x += r.vx;
			r.y += r.vy;
			r.vy *= 0.996;
			r.s += r.ds;
			r.a -= r.da;
			if (r.a <= 0) continue;
			ctx.globalAlpha = r.a;
			ctx.drawImage(r.bild, r.x - r.s / 2, r.y - r.s / 2, r.s, r.s);
		}
		rauch = rauch.filter((r) => r.a > 0 && r.y > -r.s);

		ctx.globalCompositeOperation = 'lighter';
		for (const f of fackeln) {
			const s = 46 + Math.random() * 22;
			ctx.globalAlpha = 0.9;
			ctx.drawImage(glut, f.x - s / 2, f.y - s / 2, s, s);
			ctx.globalAlpha = 0.35;
			ctx.drawImage(sprite(f.farbe), f.x - s * 1.4, f.y - s * 1.4, s * 2.8, s * 2.8);
		}
		ctx.fillStyle = '#ffd88a';
		for (const p of funken) {
			p.vy += 0.12;
			p.x += p.vx;
			p.y += p.vy;
			p.leben--;
			ctx.globalAlpha = Math.max(0, Math.min(1, p.leben / 20));
			ctx.fillRect(p.x, p.y, 2.2, 2.2);
		}
		funken = funken.filter((p) => p.leben > 0);
		ctx.globalAlpha = 1;
		ctx.globalCompositeOperation = 'source-over';

		// Ruhig: nur zeichnen, solange eine angetippte Fackel noch brennt oder raucht
		if (ruhig && !aktiv()) laeuft = false;
		if (laeuft) requestAnimationFrame(schritt);
	}

	let sichtbar = true;
	let laeuft = false;
	function steuern() {
		const soll = sichtbar && !document.hidden && (!ruhig || aktiv());
		if (soll && !laeuft) {
			laeuft = true;
			requestAnimationFrame(schritt);
		} else if (!soll) laeuft = false;
	}

	new ResizeObserver(groesse).observe(hero);
	groesse();
	new IntersectionObserver(([e]) => {
		sichtbar = e.isIntersecting;
		steuern();
	}).observe(hero);
	document.addEventListener('visibilitychange', steuern);

	hero.addEventListener('pointerdown', (e) => {
		if ((e.target as HTMLElement).closest('a')) return;
		const r = hero.getBoundingClientRect();
		zuenden(e.clientX - r.left, e.clientY - r.top);
	});
	// Mit der Maus zieht eine dünne Rauchfahne hinterher
	let zuletzt = 0;
	if (!ruhig)
		hero.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse' || e.timeStamp - zuletzt < 35) return;
			zuletzt = e.timeStamp;
			const r = hero.getBoundingClientRect();
			qualm(e.clientX - r.left, e.clientY - r.top, FARBEN[farbIndex % FARBEN.length], 0.45);
		});
</script>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		background: var(--nacht);
		/* Inhalt oben beginnen (Abstand siehe .inhalt), Bild, Verlauf und Fackeln liegen absolut dahinter */
		display: flex;
		flex-direction: column;
		align-items: center;
		overflow: hidden;
		isolation: isolate;
		cursor: crosshair;
		touch-action: manipulation;
		user-select: none;
	}
	/* Foto, vom Skript eingesetzt (ohne JavaScript bleibt der Grund dunkel) */
	.hero :global(picture) {
		display: contents;
	}
	.hero :global(.hero-bild) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}
	/* Bis das Foto da ist: Schriftzug, Hinweise und Animationen warten, dann erscheint alles zusammen */
	.inhalt,
	.tipp,
	.runter {
		transition: opacity 0.35s ease;
	}
	:global(html.hero-wartet) .inhalt,
	:global(html.hero-wartet) .tipp,
	:global(html.hero-wartet) .runter {
		opacity: 0;
	}
	:global(html.hero-wartet) .hero :global(*) {
		animation-play-state: paused;
	}
	/* Schriftzug je nach Foto: Abstand oben, und ggf. Banner/Untertitel nach unten über den Fackel-Hinweis */
	.hero .inhalt {
		padding-top: var(--hero-oben, clamp(72px, 9vh, 110px));
	}
	:global(html[data-hero-teilen]) .inhalt {
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
		min-height: 100svh;
		padding-bottom: 120px;
	}
	:global(html[data-hero-teilen='banner']) .banner,
	:global(html[data-hero-teilen='claim']) .claim {
		margin-top: auto;
	}
	.verlauf {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(ellipse at 50% 45%, rgb(20 13 22 / 0.1), rgb(20 13 22 / 0.5) 80%),
			linear-gradient(180deg, rgb(20 13 22 / 0.35) 0%, rgb(20 13 22 / 0) 35%, rgb(20 13 22 / 0.45) 75%, var(--nacht) 100%);
	}
	.rauch {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.inhalt {
		position: relative;
		text-align: center;
		padding: clamp(72px, 9vh, 110px) 16px 140px;
		pointer-events: none;
	}
	h1 {
		margin: 0;
	}
	.logo {
		width: min(580px, 84vw);
		height: auto;
		margin: 0 auto;
		filter: drop-shadow(5px 6px 0 rgb(26 18 24 / 0.9)) drop-shadow(0 0 30px rgb(0 0 0 / 0.45));
		animation:
			reinplatzen 0.9s cubic-bezier(0.2, 1.6, 0.4, 1) both,
			jubeln 4s ease-in-out 1s infinite;
		transform-origin: 50% 80%;
	}
	.banner {
		display: inline-block;
		margin: 28px 0 0;
		padding: 0.35em 1em;
		background: var(--papier);
		color: var(--tinte);
		font-size: clamp(1.1rem, 3.6vw, 1.9rem);
		line-height: 1.2;
		transform: rotate(-3deg);
		box-shadow: 6px 6px 0 var(--fackel);
		animation: flattern 3.2s ease-in-out infinite;
	}
	.claim {
		margin: 26px 0 0;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: clamp(0.78rem, 2vw, 1rem);
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.8);
	}
	.tipp {
		position: absolute;
		bottom: 76px;
		left: 0;
		right: 0;
		margin: 0;
		text-align: center;
		color: var(--sonne);
		font-size: 1.1rem;
		text-shadow: 0 2px 10px rgb(0 0 0 / 0.9);
		pointer-events: none;
		animation: pulsieren 2s ease-in-out infinite;
		transition: opacity 0.6s;
	}
	.tipp.weg {
		opacity: 0;
	}
	.runter {
		position: absolute;
		bottom: 18px;
		left: 50%;
		translate: -50% 0;
		font-size: 1.8rem;
		text-decoration: none;
		color: var(--papier);
		padding: 4px 14px;
		animation: huepfen 1.6s ease-in-out infinite;
	}

	@keyframes reinplatzen {
		from { transform: scale(0.3) rotate(-8deg); opacity: 0; }
		to { transform: scale(1) rotate(0); opacity: 1; }
	}
	@keyframes jubeln {
		0%, 100% { transform: rotate(0) scale(1); }
		20% { transform: rotate(-1.5deg) scale(1.02); }
		40% { transform: rotate(1.2deg) scale(1); }
		60% { transform: rotate(-0.6deg) scale(1.015); }
	}
	@keyframes flattern {
		0%, 100% { transform: rotate(-3deg) skewX(0); }
		50% { transform: rotate(-2deg) skewX(-3deg); }
	}
	@keyframes pulsieren {
		50% { opacity: 0.55; }
	}
	@keyframes huepfen {
		50% { translate: -50% 8px; }
	}
</style>
