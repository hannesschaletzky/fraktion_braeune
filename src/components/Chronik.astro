---
// Startseite: die neuesten Stationen als Karten, alle weiteren auf der Stationen-Seite
import { Picture } from 'astro:assets';
import { stationen, monate, ortName, slug } from '../data/stationen';

const neueste = stationen.filter((s) => s.fotos.length).slice(0, 3);
const neigungen = [-2, 1.5, -1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)'];
---

<section class="abschnitt chronik" id="stationen">
	<div class="wrap">
		<h2>Unsere <span class="bunt">{[...'Stationen'].map((c) => <span>{c}</span>)}</span></h2>
		<p class="einleitung">Von den ersten Pappschildern in Timmendorf 2022 bis zur Pyro-Wand im Pott. {stationen.length} Turniere, die neuesten:</p>

		<ul class="karten" role="list">
			{neueste.map((s, i) => (
				<li style={`--r: ${neigungen[i]}deg; --schatten: ${farben[i]}`}>
					<a href={`/stationen/#${slug(s)}`} class="karte">
						<Picture src={s.fotos[0].bild} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 900px) 340px, 92vw" alt={s.fotos[0].alt} loading="lazy" />
						<span class="wann">
							<span class="datum">{monate[s.monat - 1]} {s.jahr}</span>
							<span class="ort">{ortName(s)}{s.zusatz && ` · ${s.zusatz}`}</span>
						</span>
						<span class="motto marker">{s.motto}</span>
					</a>
				</li>
			))}
		</ul>
		<a class="alle" href="/stationen/">Alle {stationen.length} Stationen mit Fotos und Videos →</a>
	</div>
</section>

<style>
	.chronik {
		background:
			radial-gradient(ellipse at 10% 0%, rgb(255 46 77 / 0.12), transparent 50%),
			radial-gradient(ellipse at 90% 60%, rgb(165 91 255 / 0.1), transparent 50%),
			var(--nacht);
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 48px;
		font-size: 1.15rem;
	}
	.karten {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 36px 28px;
	}
	@media (min-width: 760px) {
		.karten {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.karte {
		display: grid;
		gap: 12px;
		padding: 10px 10px 16px;
		background: var(--papier);
		color: var(--tinte);
		text-decoration: none;
		box-shadow: 6px 6px 0 var(--schatten);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.karte:hover,
	.karte:focus-visible {
		transform: rotate(0) scale(1.03);
	}
	.karte :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}
	.wann {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 10px;
		padding: 0 4px;
		font-family: var(--display);
		text-transform: uppercase;
		font-size: 1.35rem;
		line-height: 1.05;
	}
	.datum {
		color: #b8860b;
	}
	.motto {
		padding: 0 4px;
		font-size: 1rem;
		line-height: 1.3;
	}
	.alle {
		display: inline-block;
		margin-top: 48px;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		border: 3px solid var(--tinte);
		background: var(--sonne);
		color: var(--tinte);
		font-family: var(--display);
		text-transform: uppercase;
		font-size: clamp(1.05rem, 3vw, 1.3rem);
		text-decoration: none;
		box-shadow: 5px 5px 0 var(--tinte);
		transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.alle:hover {
		transform: rotate(-2deg) scale(1.05);
	}
</style>
