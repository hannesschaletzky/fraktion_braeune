---
// Startseite: eine Mischung von Stationen als Karten (Auswahl in data/startseite.ts), alle auf der Stationen-Seite
import Karten from './Karten.astro';
import { stationen, monate, ortName, slug } from '../data/stationen';
import { startStationen } from '../data/startseite';

const karten = startStationen.map((s) => ({
		href: `/stationen/#${slug(s)}`,
		bild: s.fotos[0].bild,
		alt: s.fotos[0].alt,
		datum: `${monate[s.monat - 1]} ${s.jahr}`,
		ort: `${ortName(s)}${s.zusatz ? ` · ${s.zusatz}` : ''}`,
		text: s.motto,
	}));
---

<section class="abschnitt chronik" id="stationen">
	<div class="wrap">
		<h2>Unsere <span class="bunt">{[...'Stationen'].map((c) => <span>{c}</span>)}</span></h2>
		<p class="einleitung">Von den ersten Pappschildern in Timmendorf 2022 bis zur Pyro-Wand im Pott. {stationen.length} Turniere, zum Beispiel:</p>
		<Karten karten={karten} mehr={{ href: '/stationen/', text: `Alle ${stationen.length} Stationen mit Fotos und Videos →` }} />
	</div>
</section>

<style>
	.chronik {
		background:
			radial-gradient(ellipse at 10% 0%, rgb(255 46 77 / 0.12), transparent 50%),
			radial-gradient(ellipse at 90% 60%, rgb(165 91 255 / 0.1), transparent 50%),
			var(--nacht);
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 48px;
		font-size: 1.15rem;
	}
</style>
