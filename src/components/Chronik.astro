---
// Unsere Stationen, neueste zuerst. Jede Station gleich aufgebaut wie auf der Choreo-Seite:
// Datum und Ort groß, unser Satz zum Turnier, ein großes Foto, darunter weitere Fotos und Videos in einer Reihe.
import { Picture } from 'astro:assets';
import Handy from './Handy.astro';
import { grossUrl, type Foto } from '../data/fotos';
import { stationen } from '../data/stationen';

// Große Fassung für die Lightbox, einmal pro Foto
const gross = new Map<string, string>();
for (const s of stationen)
	for (const f of s.fotos) gross.set(f.bild.src, await grossUrl(f));

const monate = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const neigungen = [-2, 1.5, -1, 2, -1.5, 1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)', 'var(--sonne)', 'var(--blau)', 'var(--glut)'];
const knopf = (f: Foto) => ({ 'data-gross': gross.get(f.bild.src), 'data-alt': f.alt, 'data-credit': f.credit ?? '', 'aria-label': `Groß anzeigen: ${f.alt}` });
---

<section class="abschnitt chronik" id="stationen">
	<div class="wrap">
		<h2>Unsere <span class="bunt">{[...'Stationen'].map((c) => <span>{c}</span>)}</span></h2>
		<p class="einleitung">Von den ersten Pappschildern in Timmendorf 2022 bis zur Pyro-Wand im Pott.</p>

		<ol class="liste" role="list">
			{stationen.map((s, i) => (
				<li class="station" style={`--schatten: ${farben[i % farben.length]}`}>
					<header class="kopf">
						<h3 class="wann">
							<span class="datum">{monate[s.monat - 1]} {s.jahr}</span>
							<span class="ort">{s.ort}{s.stopp && ` ${s.stopp}`}</span>
							{s.zusatz && <span class="zusatz">{s.zusatz}</span>}
						</h3>
						<p class="motto marker">{s.motto}</p>
					</header>
					{s.fotos[0] && (
						<button type="button" class="foto haupt" style={`--r: ${neigungen[i % neigungen.length]}deg`} {...knopf(s.fotos[0])}>
							<Picture src={s.fotos[0].bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1068px, 92vw" alt={s.fotos[0].alt} loading="lazy" />
						</button>
					)}
					{(s.fotos.length > 1 || s.clips) && (
						<div class="weitere">
							{s.fotos.slice(1).map((f, j) => (
								<button type="button" class="foto klein" style={`--r: ${neigungen[(i + j + 1) % neigungen.length]}deg`} {...knopf(f)}>
									<Picture src={f.bild} formats={['avif', 'webp']} widths={[360, 640, 960]} sizes="(min-width: 760px) 400px, 70vw" alt={f.alt} loading="lazy" />
								</button>
							))}
							{s.clips?.map((c, j) => (
								<div class="handy-platz">
									<Handy clip={c} r={neigungen[(i + j + 2) % neigungen.length]} />
								</div>
							))}
						</div>
					)}
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.chronik {
		background:
			radial-gradient(ellipse at 10% 0%, rgb(255 46 77 / 0.12), transparent 50%),
			radial-gradient(ellipse at 90% 60%, rgb(165 91 255 / 0.1), transparent 50%),
			var(--nacht);
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 64px;
		font-size: 1.15rem;
	}
	.liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(80px, 12vw, 140px);
	}
	/* Immer gleiche Leserichtung: Kopf, großes Foto, Reihe mit dem Rest */
	.station {
		display: grid;
		gap: 28px;
	}

	.wann {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 14px;
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		line-height: 1.05;
	}
	.datum {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		color: var(--sonne);
	}
	.ort {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
	}
	.zusatz {
		align-self: center;
		padding: 0.15em 0.55em;
		background: var(--sonne);
		color: var(--tinte);
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		letter-spacing: 0.04em;
		transform: rotate(-3deg);
	}
	.motto {
		display: inline-block;
		margin: 14px 0 0;
		padding: 0.25em 0.8em;
		background: var(--papier);
		color: var(--tinte);
		font-size: clamp(1.1rem, 2.6vw, 1.5rem);
		transform: rotate(-1.5deg);
		box-shadow: 5px 5px 0 var(--schatten);
	}

	.foto {
		all: unset;
		box-sizing: border-box;
		cursor: zoom-in;
		padding: 10px;
		background: var(--papier);
		box-shadow: 0 16px 36px rgb(0 0 0 / 0.5);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.foto:hover,
	.foto:focus-visible {
		transform: rotate(0) scale(1.03);
		z-index: 1;
	}
	.foto:focus-visible {
		outline: 3px solid var(--sonne);
	}
	.foto :global(img) {
		display: block;
	}
	/* Ganzes Foto zeigen, nie zuschneiden; höchstens so hoch wie der Bildschirm */
	.foto.haupt {
		display: block;
		width: fit-content;
		max-width: 100%;
		transform: rotate(calc(var(--r) * 0.35));
	}
	.foto.haupt :global(img) {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 72vh;
	}
	/* Weitere Fotos und Videos: eine Reihe gleich hoher Kacheln, auf dem Handy zum Wischen */
	.weitere {
		--hoehe: clamp(220px, 26vw, 300px);
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 24px;
	}
	.foto.klein :global(img) {
		height: var(--hoehe);
		width: auto;
		max-width: 100%;
		object-fit: cover;
	}
	.handy-platz {
		width: calc(var(--hoehe) * 0.6);
		flex: none;
	}
	@media (max-width: 759px) {
		.weitere {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			margin: 0 -16px;
			padding: 8px 16px 16px;
		}
		.weitere > * {
			flex: none;
			scroll-snap-align: center;
		}
	}
</style>
