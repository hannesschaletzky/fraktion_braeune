---
import { Picture, getImage } from 'astro:assets';
import { stationen } from '../data/stationen';

// Große Fassung für die Lightbox, einmal pro Foto
const gross = new Map<string, string>();
for (const s of stationen)
	for (const f of s.fotos) gross.set(f.bild.src, (await getImage({ src: f.bild, width: 1800, format: 'webp' })).src);

const neigungen = [-3, 2.5, -1.5, 3.5, -2.5, 1.5];
---

<section class="abschnitt chronik" id="stationen">
	<div class="wrap">
		<h2>Unsere <span class="bunt">{[...'Stationen'].map((c) => <span>{c}</span>)}</span></h2>
		<p class="einleitung">Von den ersten Pappschildern in Timmendorf bis zur Pyro-Wand im Pott. Tipp auf ein Foto für die große Ansicht.</p>

		<ol class="liste" role="list">
			{stationen.map((s, i) => (
				<li class:list={['station', { gespiegelt: i % 2 === 1 }]}>
					<header class="kopf">
						<p class="jahr" aria-hidden="true">{s.jahr}</p>
						<h3>
							{s.ort}
							{s.zusatz && <span class="zusatz">{s.zusatz}</span>}
							<span class="nur-sr"> {s.jahr}</span>
						</h3>
						<p class="motto marker">{s.motto}</p>
						<p class="beschreibung">{s.text}</p>
					</header>
					<div class:list={['collage', `n${Math.min(s.fotos.length, 5)}`]}>
						{s.fotos.map((f, j) => (
							<button
								type="button"
								class="foto"
								style={`--r: ${neigungen[(i + j) % neigungen.length]}deg`}
								data-gross={gross.get(f.bild.src)}
								data-alt={f.alt}
								data-credit={f.credit ?? ''}
								aria-label={`Groß anzeigen: ${f.alt}`}
							>
								<Picture
									src={f.bild}
									formats={['avif', 'webp']}
									widths={[360, 640, 960]}
									sizes="(min-width: 900px) 360px, 50vw"
									alt=""
									loading="lazy"
								/>
							</button>
						))}
					</div>
				</li>
			))}
		</ol>
	</div>

	<dialog class="lightbox" id="lightbox" aria-label="Foto">
		<figure>
			<img id="lb-bild" alt="" />
			<figcaption>
				<span id="lb-text"></span>
				<a id="lb-credit" target="_blank" rel="noopener noreferrer"></a>
			</figcaption>
		</figure>
		<button class="lb-knopf lb-zu" type="button" aria-label="Schließen" data-aktion="zu">✕</button>
		<button class="lb-knopf lb-zurueck" type="button" aria-label="Vorheriges Foto" data-aktion="zurueck">‹</button>
		<button class="lb-knopf lb-vor" type="button" aria-label="Nächstes Foto" data-aktion="vor">›</button>
	</dialog>
</section>

<script>
	const fotos = [...document.querySelectorAll<HTMLButtonElement>('.chronik .foto')];
	const dialog = document.getElementById('lightbox') as HTMLDialogElement;
	const bild = document.getElementById('lb-bild') as HTMLImageElement;
	const text = document.getElementById('lb-text')!;
	const credit = document.getElementById('lb-credit') as HTMLAnchorElement;
	let aktuell = 0;

	function zeigen(i: number) {
		aktuell = (i + fotos.length) % fotos.length;
		const f = fotos[aktuell].dataset;
		bild.src = f.gross!;
		bild.alt = f.alt!;
		text.textContent = f.alt!;
		const c = f.credit;
		credit.hidden = !c;
		if (c) {
			credit.textContent = `📸 ${c.includes(' ') ? c : '@' + c}`;
			if (c.includes(' ')) credit.removeAttribute('href');
			else credit.href = `https://www.instagram.com/${c}/`;
		}
	}

	fotos.forEach((f, i) =>
		f.addEventListener('click', () => {
			zeigen(i);
			dialog.showModal();
		}),
	);
	dialog.addEventListener('click', (e) => {
		const ziel = e.target as HTMLElement;
		const aktion = ziel.closest<HTMLElement>('[data-aktion]')?.dataset.aktion;
		if (aktion === 'vor') zeigen(aktuell + 1);
		else if (aktion === 'zurueck') zeigen(aktuell - 1);
		else if (aktion === 'zu' || ziel === dialog) dialog.close();
	});
	dialog.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') zeigen(aktuell + 1);
		if (e.key === 'ArrowLeft') zeigen(aktuell - 1);
	});
	// Wischen auf dem Handy
	let startX = 0;
	dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
	dialog.addEventListener('touchend', (e) => {
		const dx = e.changedTouches[0].clientX - startX;
		if (Math.abs(dx) > 50) zeigen(aktuell + (dx < 0 ? 1 : -1));
	});
	dialog.addEventListener('close', () => fotos[aktuell]?.focus());
</script>

<style>
	.chronik {
		background:
			radial-gradient(ellipse at 10% 0%, rgb(255 46 77 / 0.12), transparent 50%),
			radial-gradient(ellipse at 90% 60%, rgb(165 91 255 / 0.1), transparent 50%),
			var(--nacht);
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 64px;
		font-size: 1.15rem;
	}
	.liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(80px, 12vw, 140px);
	}
	.station {
		display: grid;
		gap: 36px;
		align-items: center;
	}
	@media (min-width: 900px) {
		.station {
			grid-template-columns: 0.8fr 1.2fr;
			gap: 56px;
		}
		.station.gespiegelt .kopf {
			order: 2;
		}
	}
	.kopf {
		position: relative;
	}
	.jahr {
		font-family: var(--display);
		font-size: clamp(5rem, 16vw, 9rem);
		line-height: 0.8;
		margin: 0 0 -0.32em;
		color: transparent;
		-webkit-text-stroke: 2px rgb(248 242 231 / 0.35);
		user-select: none;
	}
	h3 {
		position: relative;
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(2rem, 5vw, 3.2rem);
		line-height: 1;
		margin: 0;
	}
	.zusatz {
		display: inline-block;
		margin-left: 0.4em;
		font-size: 0.5em;
		vertical-align: middle;
		padding: 0.2em 0.5em;
		background: var(--sonne);
		color: var(--tinte);
		transform: rotate(-4deg);
	}
	.motto {
		display: inline-block;
		margin: 18px 0 0;
		padding: 0.25em 0.8em;
		background: var(--papier);
		color: var(--tinte);
		font-size: clamp(1.1rem, 2.6vw, 1.5rem);
		transform: rotate(-2deg);
		box-shadow: 5px 5px 0 var(--fackel);
	}
	.gespiegelt .motto {
		transform: rotate(2deg);
		box-shadow: 5px 5px 0 var(--gruen);
	}
	.beschreibung {
		margin: 22px 0 0;
		max-width: 46ch;
	}

	.collage {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		grid-auto-rows: clamp(70px, 11vw, 110px);
		gap: 12px;
	}
	.foto {
		all: unset;
		box-sizing: border-box;
		position: relative;
		cursor: zoom-in;
		padding: 8px;
		background: var(--papier);
		box-shadow: 0 14px 30px rgb(0 0 0 / 0.5);
		transform: rotate(var(--r));
		transition:
			transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1),
			box-shadow 0.3s;
	}
	.foto:hover,
	.foto:focus-visible {
		transform: rotate(0) scale(1.06);
		z-index: 2;
		box-shadow: 0 24px 50px rgb(0 0 0 / 0.6);
	}
	.foto:focus-visible {
		outline: 3px solid var(--sonne);
	}
	.foto :global(picture),
	.foto :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Layouts je nach Anzahl Fotos */
	.n2 .foto:nth-child(1) { grid-column: 1 / 4; grid-row: 1 / span 4; }
	.n2 .foto:nth-child(2) { grid-column: 4 / 7; grid-row: 2 / span 4; }
	.n3 .foto:nth-child(1) { grid-column: 1 / 7; grid-row: span 3; }
	.n3 .foto:nth-child(2) { grid-column: 1 / 4; grid-row: span 2; }
	.n3 .foto:nth-child(3) { grid-column: 4 / 7; grid-row: span 2; }
	.n4 .foto:nth-child(1) { grid-column: 1 / 5; grid-row: span 3; }
	.n4 .foto:nth-child(2) { grid-column: 5 / 7; grid-row: span 3; }
	.n4 .foto:nth-child(3) { grid-column: 1 / 3; grid-row: span 2; }
	.n4 .foto:nth-child(4) { grid-column: 3 / 7; grid-row: span 2; }
	.n5 .foto:nth-child(1) { grid-column: 1 / 5; grid-row: span 3; }
	.n5 .foto:nth-child(2) { grid-column: 5 / 7; grid-row: span 3; }
	.n5 .foto:nth-child(3) { grid-column: 1 / 3; grid-row: span 2; }
	.n5 .foto:nth-child(4) { grid-column: 3 / 5; grid-row: span 2; }
	.n5 .foto:nth-child(5) { grid-column: 5 / 7; grid-row: span 2; }
	.n5 .foto:nth-child(n + 6) { display: none; }

	/* Lightbox */
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(10 6 12 / 0.94);
		color: var(--papier);
	}
	.lightbox::backdrop {
		background: transparent;
	}
	.lightbox[open] {
		display: grid;
		place-items: center;
	}
	.lightbox figure {
		margin: 0;
		padding: 56px 16px 16px;
		display: grid;
		gap: 12px;
		justify-items: center;
		max-height: 100%;
	}
	.lightbox img {
		max-width: min(1400px, 100%);
		max-height: calc(100dvh - 160px);
		width: auto;
		height: auto;
		object-fit: contain;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.6);
	}
	.lightbox figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		justify-content: center;
		text-align: center;
		max-width: 70ch;
		font-size: 0.95rem;
	}
	.lightbox figcaption a {
		font-family: var(--marker);
		color: var(--sonne);
	}
	.lb-knopf {
		position: absolute;
		border: 3px solid var(--tinte);
		background: var(--papier);
		color: var(--tinte);
		font-size: 1.6rem;
		line-height: 1;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		cursor: pointer;
		box-shadow: 3px 3px 0 var(--fackel);
	}
	.lb-zu { top: 12px; right: 12px; }
	.lb-zurueck { left: 12px; top: 50%; translate: 0 -50%; }
	.lb-vor { right: 12px; top: 50%; translate: 0 -50%; }
	@media (max-width: 640px) {
		.lb-zurueck,
		.lb-vor {
			top: auto;
			bottom: 12px;
			translate: none;
		}
	}
</style>
