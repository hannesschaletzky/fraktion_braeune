---
// Breiter Bildstreifen zwischen zwei Abschnitten der Startseite. Das Foto lädt erst beim Hinscrollen, läuft beim
// Scrollen leicht mit und geht oben und unten weich in die Farbe der Nachbar-Abschnitte über.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	bild: ImageMetadata;
	alt: string;
	/** Bildausschnitt (object-position) am Rechner und am Handy */
	pos?: string;
	posHandy?: string;
	/** Hintergrundfarbe des Abschnitts darüber und darunter (CSS-Farbe, z. B. var(--nacht-2)) */
	oben?: string;
	unten?: string;
	/** Eigenes Foto fürs Handy (z. B. ein Hochkant-Bild); sonst dasselbe wie am Rechner */
	bildHandy?: ImageMetadata;
	/** Foto senkrecht verschieben (z. B. '20%' = tiefer), damit das Wichtige (die Fackel) in der klaren Mitte des Streifens liegt */
	versatz?: string;
	versatzHandy?: string;
}
const { bild, bildHandy, alt, pos = '50% 50%', posHandy = pos, oben = 'var(--nacht)', unten = 'var(--nacht)', versatz = '0%', versatzHandy = versatz } = Astro.props;

// AVIF/WebP in mehreren Breiten; mit eigenem Handy-Foto lädt jedes Gerät nur seins
const satz = async (src: ImageMetadata, breiten: number[]) => {
	const w = breiten.filter((b) => b <= src.width);
	const [a, b] = await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src, widths: w.length ? w : [src.width], format, quality: 85 })));
	return { avif: a.srcSet.attribute, webp: b.srcSet.attribute, src: b.src };
};
const rechner = await satz(bild, [640, 1024, 1600, 2200, 2880, 3400]);
const handy = bildHandy ? await satz(bildHandy, [480, 800, 1200, 1600]) : null;
const handyFormat = '(max-width: 640px)';
---

<section class="zwischenbild" aria-label={alt} style={`--pos: ${pos}; --pos-handy: ${posHandy}; --oben: ${oben}; --unten: ${unten}; --versatz: ${versatz}; --versatz-handy: ${versatzHandy}`}>
	<div class="fenster">
	<div class="lage">
		<picture>
			{handy && <source media={handyFormat} type="image/avif" srcset={handy.avif} sizes="100vw" />}
			{handy && <source media={handyFormat} type="image/webp" srcset={handy.webp} sizes="100vw" />}
			<source type="image/avif" srcset={rechner.avif} sizes="100vw" />
			<source type="image/webp" srcset={rechner.webp} sizes="100vw" />
			<img src={rechner.src} alt={alt} loading="lazy" decoding="async" />
		</picture>
	</div>
	</div>
	<div class="schleier" aria-hidden="true"></div>
</section>

<script>
	import { ruhigGewuenscht } from '../scripts/bewegung';

	if (!ruhigGewuenscht()) {
		const streifen = [...document.querySelectorAll<HTMLElement>('.zwischenbild')];
		let wartet = false;
		const laufen = () => {
			wartet = false;
			for (const s of streifen) {
				const r = s.getBoundingClientRect();
				if (r.bottom < 0 || r.top > innerHeight) continue;
				s.querySelector<HTMLElement>('.lage')!.style.transform = `translateY(${(r.top + r.height / 2 - innerHeight / 2) * -0.15}px)`;
			}
		};
		addEventListener(
			'scroll',
			() => {
				if (wartet) return;
				wartet = true;
				requestAnimationFrame(laufen);
			},
			{ passive: true },
		);
		laufen();
	}
</script>

<style>
	/* Hintergrund läuft von der Farbe des Abschnitts darüber in die des Abschnitts darunter;
	   das Foto blendet oben und unten weich darin aus – so gibt es nirgends eine Kante */
	.zwischenbild {
		position: relative;
		height: 80vh;
		min-height: 360px;
		overflow: hidden;
		background: linear-gradient(180deg, var(--oben), var(--unten));
		--v: var(--versatz);
	}
	@media (max-width: 640px) {
		.zwischenbild {
			height: 62vh;
			--v: var(--versatz-handy);
		}
	}
	/* Fest auf den Streifen bezogen: nur die Mitte voll sichtbar, nach oben und unten sehr sanft auslaufen.
	   So entsteht nie eine Kante, egal wie weit das Foto verschoben ist. */
	.fenster {
		position: absolute;
		inset: 0;
		--maske: linear-gradient(
			180deg,
			transparent 0%,
			rgb(0 0 0 / 0.04) 6%,
			rgb(0 0 0 / 0.14) 13%,
			rgb(0 0 0 / 0.32) 20%,
			rgb(0 0 0 / 0.58) 27%,
			rgb(0 0 0 / 0.82) 34%,
			#000 42%,
			#000 54%,
			rgb(0 0 0 / 0.86) 61%,
			rgb(0 0 0 / 0.64) 68%,
			rgb(0 0 0 / 0.42) 75%,
			rgb(0 0 0 / 0.24) 82%,
			rgb(0 0 0 / 0.1) 89%,
			rgb(0 0 0 / 0.03) 95%,
			transparent 100%
		);
		-webkit-mask-image: var(--maske);
		mask-image: var(--maske);
	}
	/* Farbschleier in der Seitenfarbe: mischt das Schwarz des Fotos in den Ton der Nachbarn, statt hart abzusetzen */
	.schleier {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--oben) 55%, transparent) 0%,
			color-mix(in srgb, var(--oben) 20%, transparent) 25%,
			transparent 42%,
			transparent 56%,
			color-mix(in srgb, var(--unten) 18%, transparent) 72%,
			color-mix(in srgb, var(--unten) 45%, transparent) 88%,
			color-mix(in srgb, var(--unten) 70%, transparent) 100%
		);
	}
	/* Etwas höher als der Streifen (Mitlaufen beim Scrollen), per Versatz senkrecht verschiebbar */
	.lage {
		position: absolute;
		top: calc(-15% + var(--v));
		bottom: calc(-15% - var(--v));
		left: 0;
		right: 0;
		will-change: transform;
	}
	.lage :global(picture) {
		display: contents;
	}
	.lage :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--pos);
	}
	@media (max-width: 640px) {
		.lage :global(img) {
			object-position: var(--pos-handy);
		}
	}
</style>
