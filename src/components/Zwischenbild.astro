---
// Breiter Bildstreifen zwischen zwei Abschnitten der Startseite. Das Foto lädt erst beim Hinscrollen, läuft beim
// Scrollen leicht mit und geht oben und unten weich in die Farbe der Nachbar-Abschnitte über.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	bild: ImageMetadata;
	alt: string;
	/** Bildausschnitt (object-position) am Rechner und am Handy */
	pos?: string;
	posHandy?: string;
	/** Hintergrundfarbe des Abschnitts darüber und darunter (CSS-Farbe, z. B. var(--nacht-2)) */
	oben?: string;
	unten?: string;
	/** Foto unten bündig (wenn unten im Bild etwas Wichtiges steht, z. B. ein Spruchband); Verlauf dann nur ganz unten */
	untenBuendig?: boolean;
}
const { bild, alt, pos = '50% 50%', posHandy = pos, oben = 'var(--nacht)', unten = 'var(--nacht)', untenBuendig = false } = Astro.props;
---

<section class:list={["zwischenbild", { "unten-buendig": untenBuendig }]} aria-label={alt} style={`--pos: ${pos}; --pos-handy: ${posHandy}; --oben: ${oben}; --unten: ${unten}`}>
	<div class="lage">
		<Picture src={bild} formats={['avif', 'webp']} widths={[640, 1024, 1600, 2200, 2880, 3400]} sizes="100vw" quality={85} alt={alt} loading="lazy" decoding="async" />
	</div>
	<div class="verlauf" aria-hidden="true"></div>
</section>

<script>
	import { ruhigGewuenscht } from '../scripts/bewegung';

	if (!ruhigGewuenscht()) {
		const streifen = [...document.querySelectorAll<HTMLElement>('.zwischenbild')];
		let wartet = false;
		const laufen = () => {
			wartet = false;
			for (const s of streifen) {
				const r = s.getBoundingClientRect();
				if (r.bottom < 0 || r.top > innerHeight) continue;
				s.querySelector<HTMLElement>('.lage')!.style.transform = `translateY(${(r.top + r.height / 2 - innerHeight / 2) * -0.15}px)`;
			}
		};
		addEventListener(
			'scroll',
			() => {
				if (wartet) return;
				wartet = true;
				requestAnimationFrame(laufen);
			},
			{ passive: true },
		);
		laufen();
	}
</script>

<style>
	.zwischenbild {
		position: relative;
		height: 70vh;
		min-height: 320px;
		overflow: hidden;
		background: linear-gradient(180deg, var(--oben), var(--unten));
	}
	.lage :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--pos);
	}
	@media (max-width: 640px) {
		.zwischenbild {
			height: 62vh;
		}
		.lage :global(img) {
			object-position: var(--pos-handy);
		}
	}
	/* Etwas höher als der Streifen, damit beim Mitlaufen keine Kante sichtbar wird */
	.lage {
		position: absolute;
		inset: -15% 0;
		will-change: transform;
	}
	.lage :global(picture) {
		display: contents;
	}
	/* Oben in die Farbe des Abschnitts darüber übergehen, unten gespiegelt in die des Abschnitts darunter */
	.verlauf {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			var(--oben) 0%,
			color-mix(in srgb, var(--oben) 75%, transparent) 12%,
			color-mix(in srgb, var(--oben) 30%, transparent) 26%,
			transparent 40%,
			transparent 60%,
			color-mix(in srgb, var(--unten) 30%, transparent) 74%,
			color-mix(in srgb, var(--unten) 75%, transparent) 88%,
			var(--unten) 100%
		);
	}
	/* Unten bündig: das Foto endet kurz über dem Streifenende und blendet in seinen letzten Pixeln aus,
	   der Verlauf in den nächsten Abschnitt liegt darunter – so bleibt der untere Bildrand (Spruchband) lesbar */
	.unten-buendig .lage {
		inset: -15% 0 11% 0;
	}
	.unten-buendig .lage :global(img) {
		-webkit-mask-image: linear-gradient(180deg, #000 0, #000 97%, transparent 100%);
		mask-image: linear-gradient(180deg, #000 0, #000 97%, transparent 100%);
	}
	.unten-buendig .verlauf {
		background: linear-gradient(
			180deg,
			var(--oben) 0%,
			color-mix(in srgb, var(--oben) 75%, transparent) 12%,
			color-mix(in srgb, var(--oben) 30%, transparent) 26%,
			transparent 40%,
			transparent 88%,
			color-mix(in srgb, var(--unten) 55%, transparent) 91%,
			var(--unten) 95%
		);
	}
</style>
