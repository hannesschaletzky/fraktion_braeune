---
// Ein Fernseher mit Senderwahl: Mitschnitte aus dem Livestream. Steuerung: src/scripts/videos.ts
import '../styles/spieler.css';
import { sender } from '../data/clips';

const nr = (i: number) => String(i + 1).padStart(2, '0');
const erster = sender[0];
---

<section class="abschnitt tv" id="tv">
	<div class="wrap">
		<h2>Fanblock <span class="live">im TV</span></h2>
		<p class="einleitung">Die Regie hat schnell gemerkt, wo die Party ist. Sender wählen, Tipp aufs Bild hält an, 🔇 macht Ton an.</p>

		<div class="fernseher" data-spieler data-kanal="0">
			<div class="gehaeuse">
				<div class="schirm">
					<video
						src={`/videos/vorschau/${erster.name}.mp4`}
						data-voll={`/videos/${erster.name}.mp4`}
						data-poster={`/videos/${erster.name}.webp`}
						muted
						loop
						playsinline
						preload="none"
						aria-label={`${erster.titel}, ${erster.wann}`}
					></video>
					<span class="rauschen" aria-hidden="true"></span>
					<span class="kanal" aria-hidden="true">CH {nr(0)}</span>
					<span class="pausezeichen" aria-hidden="true">▶</span>
					<span class="knoepfe">
						<button type="button" class="ton" aria-label="Mit Ton abspielen" aria-pressed="false">🔇</button>
						<button type="button" class="gross" aria-label="Im Vollbild abspielen">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</button>
					</span>
				</div>
				<div class="bedienung">
					<p class="anzeige" aria-live="polite"><span class="nur-sr">Sender </span><span class="nummer">{nr(0)}</span></p>
					<button type="button" class="hoch" aria-label="Vorheriger Sender (in der Liste nach oben)">▲</button>
					<button type="button" class="runter" aria-label="Nächster Sender (in der Liste nach unten)">▼</button>
					<i class="regler" aria-hidden="true"></i>
					<i class="regler" aria-hidden="true"></i>
				</div>
			</div>
			<div class="fuesse" aria-hidden="true"><i></i><i></i></div>
		</div>

		<ol class="programm" role="list" aria-label="Programm">
			{sender.map((s, i) => (
				<li>
					<button type="button" data-nr={i} aria-current={i === 0 ? 'true' : undefined}>
						<span class="pnr">{nr(i)}</span>
						<span class="ptitel">{s.titel}</span>
						<span class="pwann">{s.wann}</span>
					</button>
				</li>
			))}
		</ol>
		<p class="quelle">Mitschnitte aus dem Livestream der German Beach Tour.</p>
	</div>
</section>

<script>
	import { spieler, quelle, mitTon } from '../scripts/videos';
	import { sender } from '../data/clips';

	const tv = document.querySelector<HTMLElement>('.fernseher')!;
	const video = tv.querySelector('video')!;
	const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('.programm button')];
	const nr = (i: number) => String(i + 1).padStart(2, '0');
	spieler(tv);

	function schalten(i: number, ton = false) {
		i = (i + sender.length) % sender.length;
		const s = sender[i];
		tv.dataset.kanal = String(i);
		quelle(tv, `/videos/vorschau/${s.name}.mp4`, `/videos/${s.name}.mp4`, `/videos/${s.name}.webp`);
		video.setAttribute('aria-label', `${s.titel}, ${s.wann}`);
		tv.querySelector('.kanal')!.textContent = `CH ${nr(i)}`;
		tv.querySelector('.nummer')!.textContent = nr(i);
		knoepfe.forEach((k, j) => (j === i ? k.setAttribute('aria-current', 'true') : k.removeAttribute('aria-current')));
		// Kurzes Rauschen beim Umschalten
		tv.classList.remove('wechsel');
		void tv.offsetWidth;
		tv.classList.add('wechsel');
		if (ton) mitTon(tv);
	}
	const jetzt = () => Number(tv.dataset.kanal);

	// Pfeile folgen der Programmliste darunter: ▼ zum nächsten Sender (weiter unten), ▲ zum vorherigen
	tv.querySelector('.hoch')!.addEventListener('click', () => schalten(jetzt() - 1));
	tv.querySelector('.runter')!.addEventListener('click', () => schalten(jetzt() + 1));
	knoepfe.forEach((k) => k.addEventListener('click', () => schalten(Number(k.dataset.nr))));

	// Aus den Zitaten: Sender einschalten, mit Ton, und hinscrollen
	document.addEventListener('fb:sender', (e) => {
		const i = sender.findIndex((s) => s.name === (e as CustomEvent<string>).detail);
		if (i < 0) return;
		tv.scrollIntoView({ behavior: 'smooth', block: 'center' });
		schalten(i, true);
	});
</script>

<style>
	.tv {
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.02) 0 2px, transparent 2px 4px),
			var(--nacht);
	}
	.live {
		display: inline-block;
		background: var(--fackel);
		padding: 0 0.2em;
		transform: rotate(-2deg);
	}
	.live::before {
		content: '';
		display: inline-block;
		width: 0.28em;
		height: 0.28em;
		margin-right: 0.15em;
		vertical-align: 0.25em;
		border-radius: 50%;
		background: var(--papier);
		animation: blinken 1.2s steps(1) infinite;
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 48px;
		font-size: 1.15rem;
	}

	.fernseher {
		max-width: 860px;
		margin: 0 auto;
		transform: rotate(-1deg);
	}
	.gehaeuse {
		display: grid;
		grid-template-columns: 1fr;
		gap: 14px;
		padding: clamp(12px, 2.5vw, 22px);
		border-radius: 28px;
		background: linear-gradient(160deg, #7a4b2c, #4a2b18);
		border: 3px solid var(--tinte);
		box-shadow:
			inset 0 2px 0 rgb(255 255 255 / 0.15),
			8px 10px 0 var(--tinte);
	}
	@media (min-width: 640px) {
		.gehaeuse {
			grid-template-columns: 1fr 64px;
		}
	}
	.schirm {
		aspect-ratio: 16 / 9;
		border-radius: 22px / 30px;
		border: 3px solid var(--tinte);
	}
	.schirm::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			repeating-linear-gradient(0deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 3px),
			radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55));
	}
	.kanal {
		position: absolute;
		top: 10px;
		left: 14px;
		z-index: 2;
		font-family: monospace;
		font-size: clamp(1rem, 2.4vw, 1.4rem);
		font-weight: 700;
		color: #6cff8a;
		text-shadow: 0 0 6px #2fd47a;
	}
	.rauschen {
		position: absolute;
		inset: -50%;
		z-index: 1;
		opacity: 0;
		pointer-events: none;
		background:
			repeating-radial-gradient(circle at 17% 32%, #fff 0 1px, #000 1px 3px),
			repeating-radial-gradient(circle at 73% 61%, #bbb 0 1px, transparent 1px 2px);
	}
	.wechsel .rauschen {
		animation: rauschen 0.35s steps(6) 1;
	}

	.bedienung {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}
	@media (min-width: 640px) {
		.bedienung {
			flex-direction: column;
			justify-content: flex-start;
			padding-top: 6px;
		}
	}
	.anzeige {
		margin: 0;
		padding: 4px 8px;
		border-radius: 6px;
		background: #0c140e;
		border: 2px solid var(--tinte);
		font-family: monospace;
		font-size: 1.3rem;
		font-weight: 700;
		color: #6cff8a;
		text-shadow: 0 0 6px #2fd47a;
	}
	.hoch,
	.runter {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 2px solid var(--tinte);
		background: radial-gradient(circle at 35% 35%, #eee, #888);
		color: var(--tinte);
		font-size: 1rem;
		cursor: pointer;
		box-shadow: 2px 3px 0 var(--tinte);
		transition: transform 0.15s;
	}
	.hoch:active,
	.runter:active {
		transform: translate(2px, 3px);
		box-shadow: none;
	}
	.regler {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #ddd, #555);
		border: 2px solid var(--tinte);
	}
	.fuesse {
		display: flex;
		justify-content: space-between;
		padding: 0 18%;
	}
	.fuesse i {
		width: 18px;
		height: 22px;
		background: var(--tinte);
		border-radius: 0 0 6px 6px;
	}

	.programm {
		list-style: none;
		padding: 0;
		margin: 48px auto 0;
		max-width: 860px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 10px;
	}
	.programm button {
		width: 100%;
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 12px;
		align-items: center;
		text-align: left;
		padding: 10px 14px;
		border-radius: 14px;
		border: 2px solid rgb(248 242 231 / 0.25);
		background: transparent;
		color: var(--papier);
		font: inherit;
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s, transform 0.2s;
	}
	.programm button:hover {
		border-color: var(--papier);
		transform: rotate(-1deg);
	}
	.programm button[aria-current='true'] {
		background: var(--papier);
		color: var(--tinte);
		border-color: var(--papier);
	}
	.pnr {
		grid-row: span 2;
		font-family: monospace;
		font-weight: 700;
		font-size: 1.3rem;
	}
	.ptitel {
		font-weight: 800;
		line-height: 1.2;
	}
	.pwann {
		font-size: 0.85rem;
		opacity: 0.75;
	}
	.quelle {
		margin: 32px auto 0;
		max-width: 860px;
		font-size: 0.85rem;
		opacity: 0.6;
	}
	@keyframes blinken {
		50% { opacity: 0; }
	}
	@keyframes rauschen {
		0% { opacity: 1; transform: translate(0, 0); }
		33% { transform: translate(-7%, 5%); }
		66% { transform: translate(6%, -4%); }
		100% { opacity: 0; transform: translate(-3%, 2%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.wechsel .rauschen,
		.live::before {
			animation: none;
		}
	}
</style>
