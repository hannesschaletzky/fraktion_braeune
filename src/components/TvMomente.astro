---
// Ein Fernseher mit Senderwahl: Mitschnitte aus dem Livestream. Steuerung: src/scripts/videos.ts
import '../styles/spieler.css';
import DatumZeile from './DatumZeile.astro';
import Siegel from './Siegel.astro';
import { sender, wannText } from '../data/clips';

const nr = (i: number) => String(i + 1).padStart(2, '0');
const erster = sender[0];
---

<section class="abschnitt tv" id="tv">
	<div class="wrap">
		<h2>Fanblock <span class="live">im TV</span></h2>
		<p class="einleitung">Die Regie hat schnell gemerkt, wo die Party ist. Sender wählen und ▶ drücken.</p>

		<div class="fernseher" data-spieler data-kanal="0">
			<div class="gehaeuse">
				<div class="schirm">
					<video
						src={`/videos/${erster.name}.mp4`}
						poster={`/videos/${erster.name}.webp`}
						playsinline
						preload="none"
						aria-label={`${erster.titel}, ${wannText(erster)}`}
					></video>
					<span class="rauschen" aria-hidden="true"></span>
					<span class="kanal" aria-hidden="true">CH {nr(0)}</span>
					<button type="button" class="abspielen" aria-label="Abspielen">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
					</button>
					<span class="knoepfe">
						<button type="button" class="ton" aria-label="Ton aus" aria-pressed="true">🔊</button>
						<button type="button" class="gross" aria-label="Im Vollbild abspielen">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</button>
					</span>
				</div>
				<div class="bedienung">
					<p class="anzeige" aria-live="polite"><span class="nur-sr">Sender </span><span class="nummer">{nr(0)}</span></p>
					<span class="pfeile">
						<button type="button" class="zurueck" aria-label="Vorheriger Sender">◀</button>
						<button type="button" class="weiter" aria-label="Nächster Sender">▶</button>
					</span>
					<i class="regler" aria-hidden="true"></i>
					<i class="regler" aria-hidden="true"></i>
				</div>
			</div>
			<div class="fuesse" aria-hidden="true"><i></i><i></i></div>
		</div>

		<ol class="programm" role="list" aria-label="Programm">
			{sender.map((s, i) => (
				<li>
					<button type="button" data-nr={i} aria-current={i === 0 ? 'true' : undefined}>
						<span class="pnr">{nr(i)}</span>
						<span class="ptitel">{s.titel}</span>
						<DatumZeile class="pwann" jahr={s.jahr} monat={s.monat} ort={s.ort} />
						{s.anbieter && <Siegel class="psiegel" anbieter={s.anbieter} />}
					</button>
				</li>
			))}
		</ol>
		<p class="quelle">Mitschnitte aus dem Livestream und den Stories der German Beach Tour, von BR24 Sport, WDR 4 und Twitch.</p>
	</div>
</section>

<script>
	// Ganz normaler Player: ▶ bzw. Tipp aufs Bild spielt/pausiert (mit Ton, an der aktuellen Stelle),
	// Lautsprecher schaltet nur den Ton um, ⛶ Vollbild. Kein Autoplay, keine Vorschau-Schleife.
	import { tonAus } from '../scripts/videos';
	import { sender, wannText } from '../data/clips';

	const tv = document.querySelector<HTMLElement>('.fernseher')!;
	const video = tv.querySelector('video')!;
	const ton = tv.querySelector<HTMLButtonElement>('.ton')!;
	const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('.programm button')];
	const nr = (i: number) => String(i + 1).padStart(2, '0');

	function zeigen() {
		tv.classList.toggle('laeuft', !video.paused);
		ton.textContent = video.muted ? '🔇' : '🔊';
		ton.setAttribute('aria-label', video.muted ? 'Ton an' : 'Ton aus');
		ton.setAttribute('aria-pressed', String(!video.muted));
	}
	for (const ereignis of ['play', 'pause', 'ended', 'volumechange']) video.addEventListener(ereignis, zeigen);

	// Immer nur ein Video mit Ton: läuft der Fernseher, werden die Handys stumm; bekommt ein Handy Ton, pausiert der Fernseher
	video.addEventListener('play', () => tonAus());
	const fremd = (e: Event) => {
		const v = e.target as HTMLVideoElement;
		if (v !== video && v instanceof HTMLVideoElement && !v.muted && !v.paused) video.pause();
	};
	document.addEventListener('play', fremd, true);
	document.addEventListener('volumechange', fremd, true);

	const abspielen = () => video.play().catch(() => {});
	tv.querySelector('.schirm')!.addEventListener('click', () => (video.paused ? abspielen() : video.pause()));
	tv.querySelector('.abspielen')!.addEventListener('click', (e) => {
		e.stopPropagation();
		abspielen();
	});
	ton.addEventListener('click', (e) => {
		e.stopPropagation();
		video.muted = !video.muted;
	});
	tv.querySelector('.gross')!.addEventListener('click', (e) => {
		e.stopPropagation();
		abspielen();
		const ios = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
		if (video.requestFullscreen) video.requestFullscreen().catch(() => ios.webkitEnterFullscreen?.());
		else ios.webkitEnterFullscreen?.();
	});

	/** Sender wechseln. Lief der Fernseher (oder spielen = true), läuft der neue Sender gleich weiter. */
	function schalten(i: number, spielen = false) {
		i = (i + sender.length) % sender.length;
		const s = sender[i];
		const lief = !video.paused;
		tv.dataset.kanal = String(i);
		video.src = `/videos/${s.name}.mp4`;
		video.poster = `/videos/${s.name}.webp`;
		tv.classList.toggle('hochkant', !!s.hoch);
		video.setAttribute('aria-label', `${s.titel}, ${wannText(s)}`);
		tv.querySelector('.kanal')!.textContent = `CH ${nr(i)}`;
		tv.querySelector('.nummer')!.textContent = nr(i);
		knoepfe.forEach((k, j) => (j === i ? k.setAttribute('aria-current', 'true') : k.removeAttribute('aria-current')));
		// Aktiven Sender in der Liste in die Mitte holen: am Handy seitlich, am Rechner senkrecht. Die Seite springt nicht.
		const leiste = knoepfe[i].closest('.programm') as HTMLElement;
		const li = knoepfe[i].parentElement!;
		if (leiste.scrollWidth > leiste.clientWidth)
			leiste.scrollTo({ left: li.offsetLeft - (leiste.clientWidth - li.offsetWidth) / 2, behavior: 'smooth' });
		else if (leiste.scrollHeight > leiste.clientHeight)
			leiste.scrollTo({ top: li.offsetTop - (leiste.clientHeight - li.offsetHeight) / 2, behavior: 'smooth' });
		// Kurzes Rauschen beim Umschalten
		tv.classList.remove('wechsel');
		void tv.offsetWidth;
		tv.classList.add('wechsel');
		if (lief || spielen) abspielen();
		zeigen();
	}
	const jetzt = () => Number(tv.dataset.kanal);

	tv.querySelector('.zurueck')!.addEventListener('click', () => schalten(jetzt() - 1));
	tv.querySelector('.weiter')!.addEventListener('click', () => schalten(jetzt() + 1));
	knoepfe.forEach((k) => k.addEventListener('click', () => schalten(Number(k.dataset.nr))));

	// Aus den Zitaten: Sender einschalten, abspielen und hinscrollen
	document.addEventListener('fb:sender', (e) => {
		const i = sender.findIndex((s) => s.name === (e as CustomEvent<string>).detail);
		if (i < 0) return;
		tv.scrollIntoView({ behavior: 'smooth', block: 'center' });
		schalten(i, true);
	});
	zeigen();
</script>

<style>
	/* Hochkant-Clips: ganz zeigen, links und rechts schwarz */
	.fernseher:global(.hochkant) video {
		object-fit: contain;
	}
	/* Großer Play-Knopf mitten im Bild */
	.abspielen {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		display: grid;
		justify-items: center;
		gap: 2px;
		padding: 18px;
		border-radius: 999px;
		border: 3px solid var(--tinte);
		background: var(--sonne);
		color: var(--tinte);
		font-family: var(--display);
		text-transform: uppercase;
		font-size: 0.95rem;
		letter-spacing: 0.04em;
		box-shadow: 4px 4px 0 var(--tinte);
		cursor: pointer;
		transform: translate(-50%, -50%);
		transition:
			opacity 0.25s,
			transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.abspielen svg {
		width: clamp(28px, 6vw, 44px);
		height: clamp(28px, 6vw, 44px);
		margin-left: 3px;
	}
	.abspielen:hover {
		transform: translate(-50%, -50%) scale(1.08);
	}
	/* Der große ▶ steht da, solange nichts läuft */
	.fernseher:global(.laeuft) .abspielen {
		opacity: 0;
		pointer-events: none;
	}
	.tv {
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.02) 0 2px, transparent 2px 4px),
			var(--nacht);
	}
	.live {
		display: inline-block;
		background: var(--fackel);
		padding: 0 0.2em;
		transform: rotate(-2deg);
	}
	.live::before {
		content: '';
		display: inline-block;
		width: 0.28em;
		height: 0.28em;
		margin-right: 0.15em;
		vertical-align: 0.25em;
		border-radius: 50%;
		background: var(--papier);
		animation: blinken 1.2s steps(1) infinite;
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 48px;
		font-size: 1.15rem;
	}

	.fernseher {
		max-width: 860px;
		margin: 0 auto;
		transform: rotate(-1deg);
	}
	.gehaeuse {
		display: grid;
		grid-template-columns: 1fr;
		gap: 14px;
		padding: clamp(12px, 2.5vw, 22px);
		border-radius: 28px;
		background: linear-gradient(160deg, #7a4b2c, #4a2b18);
		border: 3px solid var(--tinte);
		box-shadow:
			inset 0 2px 0 rgb(255 255 255 / 0.15),
			8px 10px 0 var(--tinte);
	}
	@media (min-width: 640px) {
		.gehaeuse {
			grid-template-columns: 1fr 104px;
		}
	}
	.schirm {
		aspect-ratio: 16 / 9;
		border-radius: 22px / 30px;
		border: 3px solid var(--tinte);
	}
	.schirm::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			repeating-linear-gradient(0deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 3px),
			radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55));
	}
	.kanal {
		position: absolute;
		top: 10px;
		left: 14px;
		z-index: 2;
		font-family: monospace;
		font-size: clamp(1rem, 2.4vw, 1.4rem);
		font-weight: 700;
		color: #6cff8a;
		text-shadow: 0 0 6px #2fd47a;
	}
	.rauschen {
		position: absolute;
		inset: -50%;
		z-index: 1;
		opacity: 0;
		pointer-events: none;
		background:
			repeating-radial-gradient(circle at 17% 32%, #fff 0 1px, #000 1px 3px),
			repeating-radial-gradient(circle at 73% 61%, #bbb 0 1px, transparent 1px 2px);
	}
	.wechsel .rauschen {
		animation: rauschen 0.35s steps(6) 1;
	}

	.bedienung {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}
	@media (min-width: 640px) {
		.bedienung {
			flex-direction: column;
			justify-content: flex-start;
			padding-top: 6px;
		}
	}
	.anzeige {
		margin: 0;
		padding: 4px 8px;
		border-radius: 6px;
		background: #0c140e;
		border: 2px solid var(--tinte);
		font-family: monospace;
		font-size: 1.3rem;
		font-weight: 700;
		color: #6cff8a;
		text-shadow: 0 0 6px #2fd47a;
	}
	.pfeile {
		display: flex;
		gap: 8px;
	}
	.zurueck,
	.weiter {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 2px solid var(--tinte);
		background: radial-gradient(circle at 35% 35%, #eee, #888);
		color: var(--tinte);
		font-size: 1rem;
		cursor: pointer;
		box-shadow: 2px 3px 0 var(--tinte);
		transition: transform 0.15s;
	}
	.zurueck:active,
	.weiter:active {
		transform: translate(2px, 3px);
		box-shadow: none;
	}
	.regler {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #ddd, #555);
		border: 2px solid var(--tinte);
	}
	.fuesse {
		display: flex;
		justify-content: space-between;
		padding: 0 18%;
	}
	.fuesse i {
		width: 18px;
		height: 22px;
		background: var(--tinte);
		border-radius: 0 0 6px 6px;
	}

	.programm {
		position: relative;
		list-style: none;
		padding: 0;
		margin: 48px auto 0;
		max-width: 860px;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 10px;
	}
	/* Alle Kästen gleich: je eine Zeile Titel und Untertitel, Überlänge endet mit … */
	.programm li {
		min-width: 0;
	}
	.programm button {
		width: 100%;
		height: 100%;
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-rows: auto auto;
		column-gap: 12px;
		align-items: center;
		text-align: left;
		padding: 10px 14px;
		border-radius: 14px;
		border: 1px solid rgb(248 242 231 / 0.16);
		background: transparent;
		color: var(--papier);
		font: inherit;
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s, transform 0.2s;
	}
	.programm button:hover {
		border-color: var(--papier);
		transform: rotate(-1deg);
	}
	.programm button[aria-current='true'] {
		background: var(--papier);
		color: var(--tinte);
		border-color: var(--papier);
	}
	.pnr {
		grid-row: span 2;
		font-family: monospace;
		font-weight: 700;
		font-size: 1.05rem;
		opacity: 0.6;
	}
	[aria-current='true'] .pnr {
		opacity: 1;
	}
	.ptitel {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-weight: 800;
		line-height: 1.25;
	}
	/* Datumszeile unter dem Titel (Komponente DatumZeile) */
	/* Fremder Sender (BR24, WDR 4): Siegel rechts im Kasten */
	.programm :global(.psiegel) {
		grid-column: 3;
		grid-row: 1 / span 2;
		align-self: center;
	}
	[aria-current='true'] :global(.psiegel) {
		border-color: var(--tinte);
		color: var(--tinte);
	}
	/* Grau wie unter den Zitaten: der Titel ist das Wichtige */
	.ptitel {
		grid-column: 2;
		grid-row: 1;
	}
	.programm :global(.pwann) {
		grid-column: 2;
		grid-row: 2;
		font-size: 0.8rem;
		opacity: 0.6;
	}
	/* Handy: einzeilige Wisch-Leiste direkt unter dem Fernseher statt langer Liste */
	@media (max-width: 759px) {
		.programm {
			position: relative;
			display: flex;
			gap: 10px;
			margin: 28px -16px 0;
			padding: 4px 16px 12px;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}
		.programm::-webkit-scrollbar {
			display: none;
		}
		.programm li {
			flex: 0 0 auto;
			width: min(64vw, 240px);
			scroll-snap-align: center;
		}
		.programm button {
			height: 100%;
		}
	}
	.quelle {
		margin: 32px auto 0;
		max-width: 860px;
		font-size: 0.85rem;
		opacity: 0.6;
	}
	/* Rechner: Programm als Liste rechts neben dem Fernseher, genau so hoch wie er und in sich scrollbar,
	   damit man zum Umschalten nie vom Bildschirm weg muss. height: 0 + min-height: 100% lässt die Liste
	   die Zeilenhöhe nicht mitbestimmen, sondern nur ausfüllen. */
	@media (min-width: 1000px) {
		.tv .wrap {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 320px;
			column-gap: 44px;
			align-items: start;
		}
		.tv h2,
		.einleitung,
		.quelle {
			grid-column: 1 / -1;
		}
		.fernseher {
			grid-column: 1;
			max-width: none;
			margin: 0;
		}
		.programm {
			grid-column: 2;
			align-self: stretch;
			height: 0;
			min-height: 100%;
			margin: 0;
			max-width: none;
			grid-template-columns: 1fr;
			grid-auto-rows: min-content;
			gap: 8px;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: 2px 8px 32px 2px;
			mask-image: linear-gradient(#000 88%, transparent);
		}
		.quelle {
			max-width: none;
			margin-left: 0;
		}
	}
	@keyframes blinken {
		50% { opacity: 0; }
	}
	@keyframes rauschen {
		0% { opacity: 1; transform: translate(0, 0); }
		33% { transform: translate(-7%, 5%); }
		66% { transform: translate(6%, -4%); }
		100% { opacity: 0; transform: translate(-3%, 2%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.wechsel .rauschen,
		.live::before {
			animation: none;
		}
	}
</style>
