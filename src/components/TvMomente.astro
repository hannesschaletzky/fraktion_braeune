---
const clips = [
	{ name: 'friesenjung', titel: 'Friesenjung', kanal: 1 },
	{ name: 'dancecam', titel: 'Dance Cam', kanal: 2 },
	{ name: 'taube', titel: 'Die Taube', kanal: 3 },
	{ name: 'biertaufe', titel: 'Biertaufe', kanal: 4 },
	{ name: 'harlemshake', titel: 'Harlem Shake', kanal: 5 },
	{ name: 'aufmpferd', titel: 'Aufm Pferd', kanal: 6 },
];
---

<section class="abschnitt tv" id="tv">
	<div class="wrap">
		<h2>Fanblock <span class="live">im TV</span></h2>
		<p class="einleitung">Timmendorf 2023: Die Regie hat schnell gemerkt, wo die Party ist. Tipp aufs Bild hält an, 🔇 macht Ton an, das Eck-Symbol Vollbild.</p>

		<ul class="geraete" role="list">
			{clips.map((c, i) => (
				<li class="geraet" style={`--r: ${[-2, 1.5, -1, 2, -1.5, 1][i]}deg`}>
					<div class="gehaeuse">
						<div class="schirm">
							<video
								src={`/videos/${c.name}.mp4`}
								data-poster={`/videos/${c.name}.webp`}
								muted
								loop
								playsinline
								preload="none"
								aria-label={c.titel}
							></video>
							<span class="kanal" aria-hidden="true">CH {String(c.kanal).padStart(2, '0')}</span>
							<span class="pausezeichen" aria-hidden="true">▶</span>
							<button type="button" class="ton" aria-label={`${c.titel} mit Ton abspielen`} aria-pressed="false">🔇</button>
							<button type="button" class="gross" aria-label={`${c.titel} im Vollbild abspielen`}>
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
							</button>
						</div>
						<div class="regler" aria-hidden="true"><i></i><i></i></div>
					</div>
					<p class="titel marker">{c.titel}</p>
				</li>
			))}
		</ul>
		<p class="quelle">Mitschnitte aus dem Livestream der German Beach Tour.</p>
	</div>
</section>

<script>
	import { ruhigGewuenscht } from '../scripts/bewegung';

	const geraete = [...document.querySelectorAll<HTMLElement>('.tv .geraet')];
	const videos = geraete.map((g) => g.querySelector('video')!);
	const ruhig = ruhigGewuenscht();
	// Von Hand angehaltene Clips laufen nicht von selbst wieder los
	const angehalten = new WeakSet<HTMLVideoElement>();

	function weiter(v: HTMLVideoElement) {
		angehalten.delete(v);
		geraete[videos.indexOf(v)].classList.remove('pause');
	}

	// Stumm abspielen, solange sichtbar (nicht bei reduzierter Bewegung)
	const beobachter = new IntersectionObserver(
		(eintraege) => {
			for (const e of eintraege) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting && !angehalten.has(v) && (!ruhig || !v.muted)) v.play().catch(() => {});
				else v.pause();
			}
		},
		{ threshold: 0.4 },
	);
	videos.forEach((v) => beobachter.observe(v));

	// Vorschaubilder erst laden, wenn die Fernseher in die Nähe kommen (spart beim Seitenaufruf ~500 KB)
	const vorlader = new IntersectionObserver(
		(eintraege, beob) => {
			for (const e of eintraege) {
				if (!e.isIntersecting) continue;
				const v = e.target as HTMLVideoElement;
				v.poster = v.dataset.poster!;
				beob.unobserve(v);
			}
		},
		{ rootMargin: '800px 0px' },
	);
	videos.forEach((v) => vorlader.observe(v));

	function tonAus(ausser?: HTMLVideoElement) {
		geraete.forEach((g, i) => {
			const v = videos[i];
			if (v === ausser) return;
			// ended zuerst lesen: mit loop = true meldet der Browser nie "ended"
			const warZuEnde = v.ended;
			v.muted = true;
			v.loop = true;
			if (ruhig) v.pause();
			else if (warZuEnde && !angehalten.has(v)) v.play().catch(() => {});
			g.classList.remove('an');
			const b = g.querySelector('.ton')!;
			b.textContent = '🔇';
			b.setAttribute('aria-pressed', 'false');
		});
	}

	geraete.forEach((g, i) => {
		const v = videos[i];
		const knopf = g.querySelector<HTMLButtonElement>('.ton')!;
		const umschalten = () => {
			const an = v.muted;
			weiter(v);
			tonAus(v);
			v.muted = !an;
			// Mit Ton nur einmal durch: In der Schleife setzt der Kommentar mitten im Satz neu ein
			v.loop = !an;
			g.classList.toggle('an', an);
			knopf.textContent = an ? '🔊' : '🔇';
			knopf.setAttribute('aria-pressed', String(an));
			if (an) {
				v.currentTime = 0;
				v.play().catch(() => {});
			} else if (ruhig) v.pause();
		};
		knopf.addEventListener('click', (e) => {
			e.stopPropagation();
			umschalten();
		});

		// Vollbild: von vorn, mit Ton und Bedienelementen
		g.querySelector('.gross')!.addEventListener('click', (e) => {
			e.stopPropagation();
			weiter(v);
			tonAus(v);
			v.muted = false;
			v.loop = false;
			v.controls = true;
			g.classList.add('an');
			knopf.textContent = '🔊';
			knopf.setAttribute('aria-pressed', 'true');
			v.currentTime = 0;
			v.play().catch(() => {});
			const iosVideo = v as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
			if (v.requestFullscreen) v.requestFullscreen().catch(() => iosVideo.webkitEnterFullscreen?.());
			else iosVideo.webkitEnterFullscreen?.();
		});
		const vollbildEnde = () => {
			if (document.fullscreenElement === v) return;
			v.controls = false;
			tonAus();
		};
		// Clip mit Ton ist durch: im Vollbild am Ende stehen lassen, sonst stumm in die Schleife zurück
		v.addEventListener('ended', () => {
			if (document.fullscreenElement === v) return;
			tonAus();
		});
		v.addEventListener('fullscreenchange', vollbildEnde);
		v.addEventListener('webkitendfullscreen', vollbildEnde);
		// Tipp aufs Bild: anhalten bzw. weiterlaufen lassen
		g.querySelector('.schirm')!.addEventListener('click', () => {
			if (v.paused) {
				weiter(v);
				v.play().catch(() => {});
			} else {
				angehalten.add(v);
				g.classList.add('pause');
				v.pause();
			}
		});
	});
</script>

<style>
	.tv {
		background:
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.02) 0 2px, transparent 2px 4px),
			var(--nacht-2);
	}
	.live {
		display: inline-block;
		background: var(--fackel);
		padding: 0 0.2em;
		transform: rotate(-2deg);
	}
	.live::before {
		content: '';
		display: inline-block;
		width: 0.28em;
		height: 0.28em;
		margin-right: 0.15em;
		vertical-align: 0.25em;
		border-radius: 50%;
		background: var(--papier);
		animation: blinken 1.2s steps(1) infinite;
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 56px;
		font-size: 1.15rem;
	}
	.geraete {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 48px 40px;
	}
	@media (min-width: 720px) {
		.geraete {
			grid-template-columns: 1fr 1fr;
		}
	}
	.geraet {
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.geraet:hover,
	.geraet.an {
		transform: rotate(0) scale(1.03);
	}
	.gehaeuse {
		display: grid;
		grid-template-columns: 1fr 34px;
		gap: 12px;
		padding: 14px;
		border-radius: 22px;
		background: linear-gradient(160deg, #7a4b2c, #4a2b18);
		border: 3px solid var(--tinte);
		box-shadow:
			inset 0 2px 0 rgb(255 255 255 / 0.15),
			6px 8px 0 var(--tinte);
	}
	.geraet:nth-child(3n + 2) .gehaeuse { background: linear-gradient(160deg, #e9e2d3, #b9b09d); }
	.geraet:nth-child(3n + 3) .gehaeuse { background: linear-gradient(160deg, #d84b3a, #8e2418); }
	.schirm {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 18px / 24px;
		overflow: hidden;
		background: #000;
		border: 3px solid var(--tinte);
		cursor: pointer;
	}
	.schirm::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			repeating-linear-gradient(0deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 3px),
			radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55));
	}
	video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.kanal {
		position: absolute;
		top: 8px;
		left: 10px;
		z-index: 1;
		font-family: monospace;
		font-weight: 700;
		color: #6cff8a;
		text-shadow: 0 0 6px #2fd47a;
	}
	.ton {
		position: absolute;
		right: 8px;
		bottom: 8px;
		z-index: 1;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 2px solid var(--tinte);
		background: var(--papier);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.pausezeichen {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		font-size: 3rem;
		color: var(--papier);
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.8);
		background: rgb(0 0 0 / 0.35);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s;
	}
	.pause .pausezeichen {
		opacity: 1;
	}
	.gross {
		position: absolute;
		right: 56px;
		bottom: 8px;
		z-index: 1;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		padding: 0;
		border-radius: 50%;
		border: 2px solid var(--tinte);
		background: var(--papier);
		color: var(--tinte);
		cursor: pointer;
		transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.gross:hover {
		transform: scale(1.12);
	}
	.gross svg {
		width: 20px;
		height: 20px;
	}
	/* Im Vollbild: ganzes Bild zeigen statt Röhren-Zuschnitt */
	video:fullscreen {
		object-fit: contain;
		background: #000;
	}
	.an .ton {
		background: var(--sonne);
		animation: wackeln 0.5s ease-in-out infinite alternate;
	}
	.regler {
		display: flex;
		flex-direction: column;
		gap: 12px;
		align-items: center;
		padding-top: 8px;
	}
	.regler i {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #ddd, #555);
		border: 2px solid var(--tinte);
	}
	.titel {
		margin: 18px 0 0;
		font-size: 1.5rem;
		line-height: 1.1;
	}
	.quelle {
		margin: 48px 0 0;
		font-size: 0.85rem;
		opacity: 0.6;
	}
	@keyframes blinken {
		50% { opacity: 0; }
	}
	@keyframes wackeln {
		to { transform: rotate(10deg) scale(1.1); }
	}
</style>
