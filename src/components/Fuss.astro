---
import { Image } from 'astro:assets';
import logo from '../assets/logo-bunt.png';
import credits from '../assets/fotos/credits.json';

const fotografen = [...new Set(Object.values(credits).filter((c): c is string => !!c && !c.includes(' ')))];
const extern = { target: '_blank', rel: 'noopener noreferrer' };
---

<footer class="fuss">
	<div class="wrap">
		<div class="oben">
			<a href="/" class="heim" aria-label="Zur Startseite">
				<Image src={logo} widths={[300, 600]} sizes="170px" alt="Fraktion Bräune" class="logo" loading="lazy" />
			</a>
			<div class="gruss">
				<p class="aufruf">Komm rüber und sag Hallo!</p>
				<p class="sprueche">
					<span class="spruch marker">Mit Liebe und LSF 50</span>
					<span class="spruch marker seit">seit 2021</span>
				</p>
			</div>
			<a class="insta" href="https://www.instagram.com/fraktion_braeune/" {...extern}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" /></svg>
				@fraktion_braeune
			</a>
		</div>

		<div class="unten">
			<p>
				📸 {fotografen.map((f, i) => (
					<Fragment>{i > 0 && ', '}<a href={`https://www.instagram.com/${f}/`} {...extern}>@{f}</a></Fragment>
				))}, German Beach Tour und Freund:innen. Danke! 💛
			</p>
			<p>
				Website: <a href="https://hschaletzky.com" {...extern}>Hannes Schaletzky</a>{' · '}<a href="https://github.com/hannesschaletzky/fraktion_braeune" {...extern}>Code auf GitHub</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.fuss {
		padding: 56px 0 28px;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(255 46 77 / 0.16), transparent 60%),
			var(--nacht);
		border-top: 4px solid var(--tinte);
	}
	.oben {
		display: grid;
		gap: 20px;
		justify-items: center;
		text-align: center;
	}
	@media (min-width: 820px) {
		.oben {
			grid-template-columns: auto 1fr auto;
			align-items: center;
			justify-items: start;
			text-align: left;
			gap: 36px;
		}
	}
	.heim {
		display: block;
	}
	.logo {
		width: 170px;
		height: auto;
		filter: drop-shadow(2px 3px 0 var(--tinte));
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.heim:hover .logo {
		transform: rotate(-3deg) scale(1.05);
	}
	.aufruf {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.35;
		max-width: 34ch;
	}
	/* Wie die Mottos in den Stationen: schräge Papierstreifen, „seit 2021“ als eigene Kachel */
	.sprueche {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 14px;
		margin: 16px 0 0;
	}
	@media (max-width: 819px) {
		.sprueche {
			justify-content: center;
		}
	}
	.spruch {
		display: inline-block;
		padding: 0.25em 0.8em;
		background: var(--papier);
		color: var(--tinte);
		font-size: 0.95rem;
		white-space: nowrap;
		transform: rotate(-2deg);
		box-shadow: 4px 4px 0 var(--fackel);
	}
	.spruch.seit {
		transform: rotate(2.5deg);
		box-shadow: 4px 4px 0 var(--gruen);
	}
	.insta {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1.2em;
		border-radius: 999px;
		border: 3px solid var(--tinte);
		background: linear-gradient(90deg, var(--fackel), var(--glut), var(--sonne));
		color: var(--tinte);
		font-family: var(--display);
		font-size: 1.15rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 4px 4px 0 var(--tinte);
		transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.insta:hover {
		transform: rotate(-2deg) scale(1.05);
	}
	.insta svg {
		width: 1.2em;
		height: 1.2em;
	}
	.unten {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 32px;
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid rgb(248 242 231 / 0.15);
		font-size: 0.85rem;
		opacity: 0.75;
	}
	@media (max-width: 819px) {
		.unten {
			justify-content: center;
			text-align: center;
		}
	}
	.unten p {
		margin: 0;
	}
	.unten a {
		color: inherit;
		text-underline-offset: 3px;
	}
	.unten a:hover {
		color: var(--sonne);
	}
</style>
