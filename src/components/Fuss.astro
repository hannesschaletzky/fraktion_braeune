---
import { Image, Picture } from 'astro:assets';
import fackel from '../assets/fotos/fuss-fackel.jpg';
import logo from '../assets/logo-bunt.png';
import credits from '../assets/fotos/credits.json';

const fotografen = [...new Set(Object.values(credits).filter((c): c is string => !!c && !c.includes(' ')))];
const extern = { target: '_blank', rel: 'noopener noreferrer' };

interface Props {
	/** Hintergrundfarbe des Abschnitts darüber, damit der Footer ohne Kante anschließt (Startseite: FAQ = --nacht-2) */
	oben?: string;
}
const { oben = 'var(--nacht)' } = Astro.props;
---

<footer class="fuss" style={`--fuss-oben: ${oben}`}>
	<!-- Rote Fackel im Dunkeln (Berlin 2026) als Abschied, lädt erst beim Runterscrollen -->
	<Picture src={fackel} formats={['avif', 'webp']} widths={[640, 1024, 1600, 2200, 2880]} sizes="100vw" quality={85} alt="" class="fackel" loading="lazy" decoding="async" />
	<div class="abdunkeln" aria-hidden="true"></div>
	<div class="wrap">
		<div class="oben">
			<a href="/" class="heim" aria-label="Zur Startseite">
				<Image src={logo} widths={[300, 600]} sizes="170px" alt="Fraktion Bräune" class="logo" loading="lazy" />
			</a>
			<div class="gruss">
				<p class="sprueche">
					<span class="spruch marker">Mit Liebe und LSF 50</span>
					<span class="spruch marker seit">seit 2021</span>
				</p>
			</div>
			<a class="insta" href="https://www.instagram.com/fraktion_braeune/" {...extern}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" /></svg>
				@fraktion_braeune
			</a>
		</div>

		<div class="unten">
			<p>
				📸 {fotografen.map((f, i) => (
					<Fragment>{i > 0 && ', '}<a href={`https://www.instagram.com/${f}/`} {...extern}>@{f}</a></Fragment>
				))}, German Beach Tour und Freund:innen. Danke! 💛
			</p>
			<p>
				Website: <a href="https://hschaletzky.com" {...extern}>Hannes Schaletzky</a>{' · '}<a href="https://github.com/hannesschaletzky/fraktion_braeune" {...extern}>Code auf GitHub</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.fuss {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 120px 0 28px;
		/* oben nahtlos aus dem FAQ (--nacht-2) kommen, keine Kante */
		background: linear-gradient(180deg, var(--fuss-oben), var(--nacht) 60%);
	}
	/* Fackel-Foto hinter dem Footer, oben weich ins Dunkel verlaufend */
	.fuss :global(picture) {
		display: contents;
	}
	.fuss :global(.fackel) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 48% 22%;
		z-index: -2;
	}
	/* Handy: kompakt. Oben das Logo, darunter frei die Glut der Fackel, dann die Sprüche und der Rest */
	@media (max-width: 819px) {
		.fuss {
			padding-top: 40px;
		}
		.gruss {
			margin-top: 110px;
		}
		.fuss :global(.fackel) {
			top: 8%;
			object-position: 36% 0%;
		}
	}
	.abdunkeln {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, var(--fuss-oben) 0%, color-mix(in srgb, var(--fuss-oben) 85%, transparent) 10%, color-mix(in srgb, var(--fuss-oben) 60%, transparent) 22%, rgb(20 13 22 / 0.4) 40%, rgb(20 13 22 / 0.35) 60%, rgb(20 13 22 / 0.85) 100%);
	}
	.oben {
		display: grid;
		gap: 20px;
		justify-items: center;
		text-align: center;
	}
	@media (min-width: 820px) {
		.oben {
			grid-template-columns: auto 1fr auto;
			align-items: center;
			justify-items: start;
			text-align: left;
			gap: 36px;
		}
	}
	.heim {
		display: block;
	}
	.logo {
		width: 170px;
		height: auto;
		filter: drop-shadow(2px 3px 0 var(--tinte));
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.heim:hover .logo {
		transform: rotate(-3deg) scale(1.05);
	}
	/* Wie die Mottos in den Stationen: schräge Papierstreifen, „seit 2021“ als eigene Kachel */
	.sprueche {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 14px;
		margin: 0;
	}
	@media (max-width: 819px) {
		.sprueche {
			justify-content: center;
		}
	}
	.spruch {
		display: inline-block;
		padding: 0.25em 0.8em;
		background: var(--papier);
		color: var(--tinte);
		font-size: 0.95rem;
		white-space: nowrap;
		transform: rotate(-2deg);
		box-shadow: 4px 4px 0 var(--fackel);
	}
	.spruch.seit {
		transform: rotate(2.5deg);
		box-shadow: 4px 4px 0 var(--gruen);
	}
	.insta {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1.2em;
		border-radius: 999px;
		border: 3px solid var(--tinte);
		background: linear-gradient(90deg, var(--fackel), var(--glut), var(--sonne));
		color: var(--tinte);
		font-family: var(--display);
		font-size: 1.15rem;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 4px 4px 0 var(--tinte);
		transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.insta:hover {
		transform: rotate(-2deg) scale(1.05);
	}
	.insta svg {
		width: 1.2em;
		height: 1.2em;
	}
	.unten {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 32px;
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid rgb(248 242 231 / 0.15);
		font-size: 0.85rem;
		opacity: 0.75;
	}
	@media (max-width: 819px) {
		.unten {
			justify-content: center;
			text-align: center;
		}
	}
	.unten p {
		margin: 0;
	}
	.unten a {
		color: inherit;
		text-underline-offset: 3px;
		/* größere Tippfläche, ohne dass sich die Zeilen verschieben */
		display: inline-block;
		padding: 6px 0;
		margin: -6px 0;
	}
	.unten p {
		line-height: 2;
	}
	/* Handy: unten Platz lassen, damit der runde Nach-oben-Knopf keine Links verdeckt */
	@media (max-width: 819px) {
		.fuss {
			padding-bottom: 88px;
		}
	}
	.unten a:hover {
		color: var(--sonne);
	}
</style>
