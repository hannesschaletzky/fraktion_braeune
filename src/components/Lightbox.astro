---
// Großansicht für alle Knöpfe mit data-gross auf der Seite (data-alt für Screenreader, data-credit optional)
---

<dialog class="lightbox" id="lightbox" aria-label="Foto" tabindex="-1" autofocus>
	<!-- Zu welcher Station/Choreo das Foto gehört: übernommen aus dem Kopf des Eintrags -->
	<div class="lb-kopf" id="lb-kopf" hidden>
		<p class="lb-wann" id="lb-wann"></p>
		<p class="lb-motto" id="lb-motto"></p>
	</div>
	<figure>
		<img id="lb-bild" alt="" />
		<figcaption><a id="lb-credit" target="_blank" rel="noopener noreferrer"></a></figcaption>
	</figure>
	<button class="lb-knopf lb-zu" type="button" aria-label="Schließen" data-aktion="zu">✕</button>
	<button class="lb-knopf lb-zurueck" type="button" aria-label="Vorheriges Foto" data-aktion="zurueck">‹</button>
	<button class="lb-knopf lb-vor" type="button" aria-label="Nächstes Foto" data-aktion="vor">›</button>
</dialog>

<script>
	const fotos = [...document.querySelectorAll<HTMLButtonElement>('button[data-gross]')];
	const dialog = document.getElementById('lightbox') as HTMLDialogElement;
	const bild = document.getElementById('lb-bild') as HTMLImageElement;
	const credit = document.getElementById('lb-credit') as HTMLAnchorElement;
	const kopf = document.getElementById('lb-kopf')!;
	const kopfWann = document.getElementById('lb-wann')!;
	const kopfMotto = document.getElementById('lb-motto')!;
	let aktuell = 0;

	// Große Fassungen vorladen; was schon geladen ist, wird sofort angezeigt
	const geladen = new Map<string, HTMLImageElement>();
	function vorladen(i: number) {
		const url = fotos[(i + fotos.length) % fotos.length]?.dataset.gross;
		if (!url || geladen.has(url)) return;
		const img = new Image();
		img.decoding = 'async';
		img.src = url;
		geladen.set(url, img);
	}

	// Blättern nur innerhalb einer Station bzw. Choreo: hinter dem letzten (oder vor dem ersten) Foto schließt die Großansicht
	function blaettern(richtung: 1 | -1) {
		const eintrag = fotos[aktuell].closest('[data-eintrag]');
		const ziel = aktuell + richtung;
		if (eintrag && fotos[ziel]?.closest('[data-eintrag]') !== eintrag) dialog.close();
		else zeigen(ziel);
	}

	function zeigen(i: number) {
		aktuell = (i + fotos.length) % fotos.length;
		const knopf = fotos[aktuell];
		const f = knopf.dataset;
		const gross = f.gross!;
		const vorab = geladen.get(gross);
		if (vorab?.complete && vorab.naturalWidth) bild.src = gross;
		else {
			// Sofort die schon geladene kleine Fassung zeigen, dann scharf stellen, sobald die große da ist
			const klein = knopf.querySelector('img')?.currentSrc;
			if (klein) bild.src = klein;
			vorladen(aktuell);
			const ziel = aktuell;
			geladen.get(gross)!.decode().then(
				() => ziel === aktuell && (bild.src = gross),
				() => ziel === aktuell && (bild.src = gross),
			);
		}
		vorladen(aktuell + 1);
		vorladen(aktuell - 1);
		bild.alt = f.alt ?? '';
		const eintrag = knopf.closest('[data-eintrag]');
		const wann = eintrag?.querySelector('.wann');
		kopf.hidden = !wann;
		dialog.classList.toggle('mit-kopf', !!wann);
		if (wann) {
			// Aus den reinen Texten neu zusammensetzen (sonst kämen die seiteneigenen Stile mit)
			const [jahr, monat] = (wann.querySelector('.datum')?.textContent ?? '').split('|').map((t) => t.trim());
			const teil = (text: string, klasse?: string) => {
				const el = document.createElement('span');
				el.textContent = text;
				if (klasse) el.className = klasse;
				return el;
			};
			const zusatz = wann.querySelector('.zusatz')?.textContent?.trim();
			// Zwei Gruppen: „Jahr | Monat“ und „Ort [Zusatz]“ – am Rechner nebeneinander, am Handy untereinander
			const gruppe = (klasse: string, ...kinder: HTMLElement[]) => {
				const el = teil('', klasse);
				el.append(...kinder);
				return el;
			};
			kopfWann.replaceChildren(
				gruppe('wann-datum', teil(jahr), teil('|', 'strich'), teil(monat), teil('|', 'strich nur-breit')),
				gruppe('wann-ort', teil(wann.querySelector('.ort')?.textContent?.trim() ?? '', 'ort'), ...(zusatz ? [teil(zusatz, 'zusatz')] : [])),
			);
			kopfMotto.textContent = eintrag!.querySelector('.motto, .titel')?.textContent ?? '';
			kopfMotto.hidden = !kopfMotto.textContent;
		}
		const c = f.credit;
		credit.hidden = !c;
		if (c) {
			const handle = !c.includes(' ');
			credit.textContent = `📸 ${handle ? '@' + c : c}`;
			if (handle) credit.href = `https://www.instagram.com/${c}/`;
			else credit.removeAttribute('href');
		}
	}

	// Seite dahinter festhalten (iPhone scrollt sonst beim Wischen mit) und beim Schließen an derselben Stelle stehen
	let seiteY = 0;
	fotos.forEach((f, i) =>
		f.addEventListener('click', () => {
			seiteY = scrollY;
			zeigen(i);
			dialog.showModal();
			document.documentElement.classList.add('lb-offen');
			// Fokus auf den Dialog selbst, nicht auf den Fotografen-Link (sonst steht der gelb umrandet da)
			dialog.focus({ preventScroll: true });
		}),
	);
	dialog.addEventListener('close', () => {
		document.documentElement.classList.remove('lb-offen');
		if (Math.abs(scrollY - seiteY) > 5) scrollTo({ top: seiteY, behavior: 'instant' });
		fotos[aktuell]?.focus({ preventScroll: true });
	});
	dialog.addEventListener('click', (e) => {
		const ziel = e.target as HTMLElement;
		const aktion = ziel.closest<HTMLElement>('[data-aktion]')?.dataset.aktion;
		if (aktion === 'vor') blaettern(1);
		else if (aktion === 'zurueck') blaettern(-1);
		else if (aktion === 'zu' || ziel === dialog || ziel.tagName === 'FIGURE') dialog.close();
	});
	dialog.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') blaettern(1);
		if (e.key === 'ArrowLeft') blaettern(-1);
	});
	// Wischen: seitlich = nächstes/voriges Foto, hoch oder runter = schließen. Mit einem Finger scrollt nichts.
	let startX = 0;
	let startY = 0;
	dialog.addEventListener(
		'touchstart',
		(e) => {
			startX = e.touches[0].clientX;
			startY = e.touches[0].clientY;
		},
		{ passive: true },
	);
	dialog.addEventListener(
		'touchmove',
		(e) => {
			if (e.touches.length === 1) e.preventDefault();
		},
		{ passive: false },
	);
	dialog.addEventListener('touchend', (e) => {
		const dx = e.changedTouches[0].clientX - startX;
		const dy = e.changedTouches[0].clientY - startY;
		if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) blaettern(dx < 0 ? 1 : -1);
		else if (Math.abs(dy) > 80 && Math.abs(dy) > Math.abs(dx) * 1.5) dialog.close();
	});
</script>

<style>
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(10 6 12 / 0.94);
		color: var(--papier);
	}
	.lightbox:focus {
		outline: none;
	}
	:global(html.lb-offen) {
		overflow: hidden;
	}
	.lightbox {
		overscroll-behavior: contain;
	}
	.lightbox::backdrop {
		background: transparent;
	}
	.lightbox[open] {
		display: grid;
		place-items: center;
	}
	figure {
		margin: 0;
		padding: 64px 16px 16px;
		display: grid;
		gap: 12px;
		justify-items: center;
	}
	img {
		/* Viewport-Einheiten statt Prozent: sonst kann das Bild im Grid auf 0 zusammenfallen */
		max-width: min(1400px, calc(100vw - 32px));
		max-height: calc(100dvh - 140px);
		width: auto;
		height: auto;
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.6);
	}
	figcaption a {
		font-family: var(--marker);
		color: var(--sonne);
	}
	/* Kopf oben links: Jahr | Monat | Ort wie in der Liste, darunter Motto bzw. Choreo-Titel */
	.lb-kopf {
		position: absolute;
		top: 14px;
		left: 16px;
		right: 76px;
	}
	.lb-kopf p {
		margin: 0;
	}
	.lb-wann {
		font-family: var(--display);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: clamp(1.1rem, 3vw, 1.5rem);
		line-height: 1.2;
		/* Abstände unabhängig davon, wie die Seite die Teile zusammensetzt (Leerzeichen oder nicht) */
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.3em;
	}
	.lb-wann :global(.wann-datum),
	.lb-wann :global(.wann-ort) {
		display: inline-flex;
		align-items: baseline;
		column-gap: 0.3em;
	}
	.lb-wann :global(.strich) {
		opacity: 0.35;
	}
	/* Handy: Jahr | Monat oben, darunter der Ort, darunter die Beschreibung */
	@media (max-width: 640px) {
		.lb-wann {
			flex-direction: column;
			align-items: flex-start;
			font-size: 1.55rem;
			/* genug Luft, damit die Punkte von Ä, Ö, Ü nicht in die Zeile darüber ragen */
			line-height: 1.3;
			row-gap: 0.1em;
		}
		.lb-wann :global(.nur-breit) {
			display: none;
		}
		.lb-wann :global(.wann-datum) {
			font-size: 0.7em;
			opacity: 0.9;
		}
		.lb-motto {
			margin-top: 4px;
		}
		.lightbox.mit-kopf figure {
			padding-top: 148px;
		}
		.lightbox.mit-kopf img {
			max-height: calc(100dvh - 224px);
		}
	}
	.lb-wann :global(.ort) {
		color: var(--sonne);
	}
	.lb-wann :global(.zusatz) {
		display: inline-block;
		margin-left: 0.15em;
		padding: 0 0.35em;
		border: 2px solid var(--sonne);
		border-radius: 3px;
		font-size: 0.7em;
		line-height: 1.35;
		align-self: center;
		color: var(--sonne);
	}
	.lb-motto {
		margin-top: 2px;
		font-family: var(--marker);
		font-size: clamp(0.95rem, 2.4vw, 1.1rem);
		line-height: 1.3;
		color: rgb(248 242 231 / 0.75);
		/* höchstens zwei Zeilen, danach … */
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
	}
	.lb-motto[hidden] {
		display: none;
	}
	/* Mit Kopf etwas mehr Platz oben lassen */
	.mit-kopf figure {
		padding-top: 96px;
	}
	.mit-kopf img {
		max-height: calc(100dvh - 172px);
	}
	.lb-knopf {
		position: absolute;
		border: 3px solid var(--tinte);
		background: var(--papier);
		color: var(--tinte);
		font-size: 1.6rem;
		line-height: 1;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		cursor: pointer;
		box-shadow: 3px 3px 0 var(--fackel);
	}
	.lb-zu { top: 12px; right: 12px; }
	.lb-zurueck { left: 12px; top: 50%; translate: 0 -50%; }
	.lb-vor { right: 12px; top: 50%; translate: 0 -50%; }
	@media (max-width: 640px) {
		.lb-zurueck,
		.lb-vor {
			top: auto;
			bottom: 12px;
			translate: none;
		}
	}
</style>
