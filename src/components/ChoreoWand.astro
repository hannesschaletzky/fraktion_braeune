---
// Startseite: unsere größten Choreos als Karten (Auswahl in data/startseite.ts), alle auf der Choreo-Seite
import Karten from './Karten.astro';
import { choreos, slug } from '../data/choreos';
import { monate } from '../data/stationen';
import { startChoreos } from '../data/startseite';

const karten = startChoreos.map((c) => ({
	href: `/choreos/#${slug(c)}`,
	bild: c.fotos[0].bild,
	alt: c.fotos[0].alt,
	datum: `${monate[c.monat - 1]} ${c.jahr}`,
	ort: `${c.ort}${c.stopp ? ` ${c.stopp}` : ''}${c.zusatz ? ` · ${c.zusatz}` : ''}`,
	text: c.vonAnderen ? `${c.titel} · für uns 💜` : c.titel,
	fokus: c.fokus,
}));
---

<section class="abschnitt wand" id="choreos">
	<div class="wrap">
		<h2>Unsere <span class="bunt">{[...'Choreos'].map((c) => <span>{c}</span>)}</span></h2>
		<p class="einleitung">Banner, Fahnen, Papptafeln und Rauch. {choreos.length} Choreos, unsere größten:</p>
		<Karten karten={karten} mehr={{ href: '/choreos/', text: `Alle ${choreos.length} Choreos mit Fotos und Videos →` }} />
	</div>
</section>

<style>
	.wand {
		/* Oben weich aus dem dunkleren Abschnitt davor (--nacht) einlaufen, keine Kante */
		background:
			linear-gradient(180deg, var(--nacht) 0, rgb(20 13 22 / 0.6) 90px, rgb(20 13 22 / 0.25) 170px, rgb(20 13 22 / 0) 260px),
			radial-gradient(ellipse at 80% 0%, rgb(47 212 122 / 0.12), transparent 50%),
			var(--nacht-2);
	}
	.einleitung {
		max-width: 52ch;
		margin: 0 0 48px;
		font-size: 1.15rem;
	}
</style>
