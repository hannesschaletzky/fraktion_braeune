---
const stufen = ['Bibliothek', 'Kreisliga', 'Stimmung!', 'Center Court bebt', 'Europas lauteste'];
---

<section class="abschnitt laut" id="laut">
	<div class="wrap">
		<h2>Wie laut <span class="bunt">{[...'seid ihr'].map((c) => <span>{c}</span>)}</span>?</h2>
		<p class="einleitung">Drück und halt den Knopf oder hämmer drauf. Schaffst du Fraktion-Bräune-Niveau?</p>

		<div class="anlage">
			<div class="meter" aria-hidden="true">
				<div class="fuellung" id="laut-fuellung"></div>
				<div class="skala">
					{stufen.map((s) => <span>{s}</span>)}
				</div>
			</div>
			<p class="anzeige"><span id="laut-db">0</span> dB · <span id="laut-stufe" class="marker">{stufen[0]}</span></p>
			<p class="nur-sr" aria-live="polite" id="laut-ansage"></p>
			<button type="button" class="knopf" id="laut-knopf">LAUTER!</button>
		</div>
	</div>
</section>

<script>
	import { konfetti, ruhigGewuenscht } from '../scripts/konfetti';

	const STUFEN = ['Bibliothek', 'Kreisliga', 'Stimmung!', 'Center Court bebt', 'Europas lauteste 🔥'];
	const MAX = 130;
	const knopf = document.getElementById('laut-knopf') as HTMLButtonElement;
	const fuellung = document.getElementById('laut-fuellung')!;
	const db = document.getElementById('laut-db')!;
	const stufe = document.getElementById('laut-stufe')!;
	const ansage = document.getElementById('laut-ansage')!;
	const abschnitt = document.getElementById('laut')!;

	let pegel = 0;
	let gedrueckt = false;
	let laeuft = false;
	let letzteStufe = 0;
	let gefeiert = false;

	function anzeigen() {
		const anteil = pegel / MAX;
		fuellung.style.transform = `scaleX(${anteil})`;
		db.textContent = String(Math.round(pegel));
		const s = Math.min(STUFEN.length - 1, Math.floor(anteil * STUFEN.length));
		if (s !== letzteStufe) {
			letzteStufe = s;
			stufe.textContent = STUFEN[s];
			ansage.textContent = STUFEN[s];
		}
		knopf.style.setProperty('--zittern', String(anteil));
		if (pegel >= MAX - 0.5 && !gefeiert) {
			gefeiert = true;
			konfetti(220);
			if (!ruhigGewuenscht()) abschnitt.classList.add('beben');
			setTimeout(() => abschnitt.classList.remove('beben'), 700);
		}
		if (pegel < MAX * 0.6) gefeiert = false;
	}

	function schritt() {
		pegel = gedrueckt ? Math.min(MAX, pegel + 1.1) : Math.max(0, pegel - 0.45);
		anzeigen();
		if (pegel > 0 || gedrueckt) requestAnimationFrame(schritt);
		else laeuft = false;
	}
	function starten() {
		if (!laeuft) {
			laeuft = true;
			requestAnimationFrame(schritt);
		}
	}

	knopf.addEventListener('pointerdown', (e) => {
		knopf.setPointerCapture(e.pointerId);
		gedrueckt = true;
		pegel = Math.min(MAX, pegel + 7);
		starten();
	});
	for (const typ of ['pointerup', 'pointercancel', 'lostpointercapture'])
		knopf.addEventListener(typ, () => (gedrueckt = false));
	// Tastatur: jeder Druck auf Enter/Leertaste zählt
	knopf.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			pegel = Math.min(MAX, pegel + 9);
			starten();
		}
	});
	knopf.addEventListener('contextmenu', (e) => e.preventDefault());
</script>

<style>
	.laut {
		background:
			radial-gradient(ellipse at 50% 120%, rgb(255 122 26 / 0.25), transparent 60%),
			var(--nacht);
		text-align: center;
	}
	.laut h2,
	.einleitung {
		margin-inline: auto;
	}
	.einleitung {
		max-width: 46ch;
		font-size: 1.15rem;
		margin-bottom: 48px;
	}
	.anlage {
		max-width: 760px;
		margin: 0 auto;
	}
	.meter {
		position: relative;
		height: 64px;
		border: 4px solid var(--tinte);
		border-radius: 999px;
		background: var(--nacht-2);
		overflow: hidden;
		box-shadow:
			6px 6px 0 var(--tinte),
			inset 0 0 0 3px rgb(255 255 255 / 0.06);
	}
	.fuellung {
		position: absolute;
		inset: 0;
		transform-origin: left;
		transform: scaleX(0);
		background: linear-gradient(90deg, var(--gruen), var(--sonne) 45%, var(--glut) 70%, var(--fackel));
	}
	.skala {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		align-items: center;
	}
	.skala span {
		border-left: 2px dashed rgb(248 242 231 / 0.35);
		height: 100%;
		display: grid;
		place-items: center;
		font-size: clamp(0.6rem, 1.7vw, 0.85rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--papier);
		text-shadow: 0 1px 3px rgb(0 0 0 / 0.8);
		padding: 0 4px;
		line-height: 1.1;
	}
	.skala span:first-child {
		border-left: 0;
	}
	.anzeige {
		margin: 28px 0 32px;
		font-family: var(--display);
		font-size: clamp(1.6rem, 5vw, 2.6rem);
		text-transform: uppercase;
	}
	.anzeige .marker {
		text-transform: none;
		color: var(--sonne);
	}
	.knopf {
		--zittern: 0;
		width: clamp(170px, 40vw, 220px);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 5px solid var(--tinte);
		background: radial-gradient(circle at 35% 30%, #ff6b80, var(--fackel) 60%, #b5112b);
		color: var(--papier);
		font-family: var(--display);
		font-size: clamp(1.8rem, 5vw, 2.4rem);
		letter-spacing: 0.04em;
		cursor: pointer;
		box-shadow:
			0 10px 0 #7d0a1c,
			0 18px 30px rgb(0 0 0 / 0.5);
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		transition: transform 0.08s, box-shadow 0.08s;
		animation: zittern 0.12s linear infinite;
	}
	.knopf:active {
		transform: translateY(8px);
		box-shadow:
			0 2px 0 #7d0a1c,
			0 8px 20px rgb(0 0 0 / 0.5);
	}
	.beben {
		animation: beben 0.6s;
	}
	@keyframes zittern {
		25% { translate: calc(var(--zittern) * 3px) calc(var(--zittern) * -2px); rotate: calc(var(--zittern) * 2deg); }
		75% { translate: calc(var(--zittern) * -3px) calc(var(--zittern) * 2px); rotate: calc(var(--zittern) * -2deg); }
	}
	@keyframes beben {
		10%, 50%, 90% { transform: translate(-8px, 4px) rotate(-0.5deg); }
		30%, 70% { transform: translate(8px, -4px) rotate(0.5deg); }
	}
</style>
