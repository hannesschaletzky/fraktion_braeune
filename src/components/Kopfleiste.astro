---
// Schmale Leiste oben, immer da. Ganz oben durchsichtig ohne kleines Logo (dort steht das große),
// beim Scrollen blenden Hintergrund und Logo ein.
import { Image } from 'astro:assets';
import logo from '../assets/logo-bunt.png';

interface Props {
	/** Unterseiten: von Anfang an mit Hintergrund und Logo (kein großes Logo oben) */
	fest?: boolean;
}
const { fest = false } = Astro.props;

const links = [
	{ href: '/#wir', text: 'Wir' },
	{ href: '/#stimmen', text: 'Stimmen' },
	{ href: '/#tv', text: 'TV' },
	{ href: '/choreos/', text: 'Choreos', immer: true },
	{ href: '/stationen/', text: 'Stationen', immer: true },
];
---

<header class:list={["kopfleiste", { da: fest }]} data-fest={fest ? "" : undefined} aria-label="Fraktion Bräune">
	<a href="/" class="marke" aria-label="Fraktion Bräune, zur Startseite">
		<Image src={logo} widths={[100, 200, 300]} sizes="100px" format="png" loading="eager" alt="" class="logo" />
	</a>
	<!-- Auf Stationen und Choreos: zeigt beim Scrollen, wo man gerade ist (Jahr | Monat | Ort) -->
	<p class="kontext" aria-hidden="true"></p>
	<nav aria-label="Abschnitte">
		{links.map((l) => (
			<a href={l.href} class:list={{ immer: l.immer }} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>
				{l.text}
			</a>
		))}
		<a href="https://www.instagram.com/fraktion_braeune/" target="_blank" rel="noopener noreferrer" class="insta immer" aria-label="Instagram">
			<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" /><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" /></svg>
		</a>
	</nav>
</header>

<script>
	const leiste = document.querySelector<HTMLElement>('.kopfleiste')!;
	const fest = leiste.hasAttribute('data-fest');
	let da = fest;
	let wartet = false;
	function pruefen() {
		wartet = false;
		// Hintergrund und kleines Logo, sobald das große Logo oben aus dem Bild ist
		const soll = fest || scrollY > innerHeight * 0.45;
		if (soll !== da) {
			da = soll;
			leiste.classList.toggle('da', soll);
		}
	}
	addEventListener(
		'scroll',
		() => {
			if (wartet) return;
			wartet = true;
			requestAnimationFrame(pruefen);
		},
		{ passive: true },
	);
	pruefen();

	// Mitlaufende Überschrift: solange der Kopf einer Station/Choreo oben aus dem Bild ist, ihr Ende (inkl. Videos)
	// aber noch nicht, steht „Jahr | Monat | Ort“ in der Leiste.
	const kontext = leiste.querySelector<HTMLElement>('.kontext')!;
	const eintraege = [...document.querySelectorAll<HTMLElement>('[data-eintrag]')].filter((e) => e.querySelector('.wann'));
	if (eintraege.length) {
		// Linke Kante wie die Köpfe der Einträge, aber nie unter dem Logo; rechts nie unter die Links
		const ausrichten = () => {
			const links = eintraege[0].querySelector('.wann')!.getBoundingClientRect().left;
			const logo = leiste.querySelector('.marke')!.getBoundingClientRect().right + 24;
			leiste.style.setProperty('--kontext-links', `${Math.round(Math.max(links, logo))}px`);
			leiste.style.setProperty('--nav-breite', `${leiste.querySelector('nav')!.offsetWidth + 32}px`);
		};
		ausrichten();
		addEventListener('resize', ausrichten);
		let zeigt: HTMLElement | null = null;
		let wartetK = false;
		const kontextPruefen = () => {
			wartetK = false;
			const linie = leiste.offsetHeight + 4;
			const aktiv =
				eintraege.find((e) => {
					if (e.hidden) return false;
					const kopf = e.querySelector('.wann')!.getBoundingClientRect();
					const r = e.getBoundingClientRect();
					return kopf.bottom < linie && r.bottom > linie + 40;
				}) ?? null;
			if (aktiv === zeigt) return;
			zeigt = aktiv;
			if (aktiv) kontext.innerHTML = aktiv.querySelector('.wann')!.innerHTML;
			leiste.classList.toggle('mit-kontext', !!aktiv);
		};
		addEventListener('scroll', () => {
			if (wartetK) return;
			wartetK = true;
			requestAnimationFrame(kontextPruefen);
		}, { passive: true });
		kontextPruefen();
	}

	// Auf der Startseite führt das Logo sanft nach oben statt neu zu laden
	leiste.querySelector('.marke')!.addEventListener('click', (e) => {
		if (location.pathname !== '/') return;
		e.preventDefault();
		scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
	});
</script>

<style>
	.kopfleiste {
		position: fixed;
		inset: 0 0 auto;
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 56px;
		padding: 0 max(16px, env(safe-area-inset-right)) 0 max(16px, env(safe-area-inset-left));
		border-bottom: 3px solid transparent;
		/* Immer da; ganz oben durchsichtig, gescrollt mit Hintergrund (weich überblendet) */
		background: transparent;
		border-bottom-color: transparent;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		transition:
			background-color 0.45s ease,
			border-color 0.45s ease,
			box-shadow 0.45s ease;
	}
	.kopfleiste.da {
		background: rgb(20 13 22 / 0.86);
		border-bottom-color: var(--tinte);
		box-shadow: 0 3px 0 rgb(255 46 77 / 0.5);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}
	/* Kleines Logo erst gescrollt, oben steht das große */
	.marke {
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.45s ease,
			visibility 0s linear 0.45s;
	}
	.da .marke {
		opacity: 1;
		visibility: visible;
		transition:
			opacity 0.45s ease,
			visibility 0s;
	}
	/* Ganz oben über dem Foto: Schatten, damit die Links lesbar bleiben */
	.kopfleiste:not(.da) nav a {
		text-shadow: 0 1px 8px rgb(0 0 0 / 0.7);
	}
	.marke {
		display: block;
	}
	.logo {
		display: block;
		height: 40px;
		width: auto;
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.marke:hover .logo {
		transform: rotate(-4deg) scale(1.06);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	nav a {
		padding: 0.35em 0.75em;
		border-radius: 999px;
		font-family: var(--display);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 1rem;
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}
	nav a[aria-current='page'] {
		background: var(--sonne);
		color: var(--tinte);
	}
	nav a:hover {
		background: var(--papier);
		color: var(--tinte);
	}
	.insta {
		display: grid;
		place-items: center;
		padding: 0.35em;
	}
	.insta svg {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 640px) {
		nav a:not(.immer) {
			display: none;
		}
	}
	/* Mitlaufende Überschrift neben dem Logo, gleiche Schrift wie die Köpfe der Stationen */
	.kontext {
		flex: 1;
		min-width: 0;
		margin: 0 0 0 -4px;
		padding-left: 10px;
		border-left: 2px solid rgb(248 242 231 / 0.2);
		font-family: var(--display);
		font-size: clamp(1rem, 2.2vw, 1.35rem);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0.3s;
	}
	/* Rechner: Überschrift auf derselben linken Kante wie die Köpfe der Einträge (per Skript gemessen);
	   auf schmaleren Fenstern mindestens rechts vom Logo */
	@media (min-width: 641px) {
		.kontext {
			position: absolute;
			left: var(--kontext-links, 140px);
			right: var(--nav-breite, 520px);
			margin: 0;
			padding-left: 0;
			border-left: 0;
		}
	}
	.mit-kontext .kontext {
		opacity: 1;
		visibility: visible;
		transition:
			opacity 0.3s ease,
			visibility 0s;
	}
	.kontext :global(.datum),
	.kontext :global(.ort) {
		font-size: inherit;
	}
	.kontext :global(.strich) {
		margin: 0 0.35em;
		opacity: 0.35;
	}
	.kontext :global(.ort) {
		color: var(--sonne);
	}
	.kontext :global(.zusatz) {
		margin-left: 0.5em;
		font-size: 0.75em;
		color: var(--sonne);
		opacity: 0.8;
	}
	/* Handy: Platz schaffen, solange die Überschrift steht */
	@media (max-width: 640px) {
		.mit-kontext nav a:not(.insta) {
			display: none;
		}
		.kontext {
			font-size: 0.95rem;
			letter-spacing: 0.01em;
		}
		.kontext :global(.strich) {
			margin: 0 0.2em;
		}
	}
</style>
