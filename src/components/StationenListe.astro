---
// Alle Stationen, neueste zuerst (Stationen-Seite). Jede Station gleich aufgebaut wie eine Choreo:
// Datum und Ort groß, unser Satz zum Turnier, ein großes Foto, darunter eine Reihe Fotos und eine Reihe Videos.
import { Picture } from 'astro:assets';
import Handy from './Handy.astro';
import { grossUrl, type Foto } from '../data/fotos';
import { stationen, monate, ortName, slug } from '../data/stationen';

// Große Fassung für die Lightbox, einmal pro Foto
const gross = new Map<string, string>();
for (const s of stationen)
	for (const f of s.fotos) gross.set(f.bild.src, await grossUrl(f));

const neigungen = [-2, 1.5, -1, 2, -1.5, 1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)', 'var(--sonne)', 'var(--blau)', 'var(--glut)'];
const knopf = (f: Foto) => ({ 'data-gross': gross.get(f.bild.src), 'data-alt': f.alt, 'data-credit': f.credit ?? '', 'aria-label': `Groß anzeigen: ${f.alt}` });
---

		<ol class="liste" role="list">
	{stationen.map((s, i) => (
		<li class="station" id={slug(s)} data-eintrag data-jahr={s.jahr} style={`--schatten: ${farben[i % farben.length]}`}>
			<header class="kopf">
				<h2 class="wann">
					<span class="datum">{s.jahr}<span class="strich" aria-hidden="true">|</span><span class="monat">{monate[s.monat - 1].slice(0, 3)}</span><span class="strich" aria-hidden="true">|</span></span>
					<span class="ort">{ortName(s)}</span>
					{s.zusatz && <span class="zusatz">{s.zusatz}</span>}
				</h2>
				<p class="motto marker">{s.motto}</p>
			</header>
			{s.fotos[0] && (
				<button type="button" class="foto haupt" style={`--r: ${neigungen[i % neigungen.length]}deg`} {...knopf(s.fotos[0])}>
					<Picture src={s.fotos[0].bild} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1068px, 92vw" alt={s.fotos[0].alt} loading="lazy" />
				</button>
			)}
			{s.fotos.length > 1 && (
				<div class="weitere">
					{s.fotos.slice(1).map((f, j) => (
						<button type="button" class="foto klein" style={`--r: ${neigungen[(i + j + 1) % neigungen.length]}deg`} {...knopf(f)}>
							<Picture src={f.bild} formats={['avif', 'webp']} widths={[360, 640, 960]} sizes="(min-width: 760px) 400px, 70vw" alt={f.alt} loading="lazy" />
						</button>
					))}
				</div>
			)}
			{s.clips && (
				<div class="weitere">
					{s.clips.map((c, j) => (
						<div class="handy-platz">
							<Handy clip={c} r={neigungen[(i + j + 2) % neigungen.length]} />
						</div>
					))}
				</div>
			)}
		</li>
	))}
</ol>

<style>
	.liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(80px, 12vw, 140px);
	}
	/* Immer gleiche Leserichtung: Kopf, großes Foto, Reihe mit dem Rest */
	.station {
		display: grid;
		gap: 28px;
	}

	.wann {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 14px;
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		line-height: 1.05;
	}
	/* Jahr | Monat (drei Buchstaben) | Ort; Datum weiß, Ort gelb */
	.datum {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		font-variant-numeric: tabular-nums;
	}
	/* Dezente Striche zwischen Jahr, Monat und Ort */
	.strich {
		margin: 0 0.35em;
		opacity: 0.35;
	}
	/* Nach dem letzten Strich sorgt schon der Abstand der Zeile für Luft */
	.strich:last-child {
		margin-right: 0;
	}
	/* Der Tourstopp ist das Wichtigste: gelb */
	.ort {
		font-size: clamp(1.6rem, 4vw, 2.3rem);
		color: var(--sonne);
	}
	.zusatz {
		align-self: center;
		padding: 0.15em 0.55em;
		border: 2px solid var(--sonne);
		color: var(--sonne);
		font-size: clamp(0.95rem, 2.2vw, 1.15rem);
		letter-spacing: 0.04em;
		transform: rotate(-3deg);
	}
	.motto {
		display: inline-block;
		margin: 14px 0 0;
		padding: 0.25em 0.8em;
		background: var(--papier);
		color: var(--tinte);
		font-size: clamp(1.1rem, 2.6vw, 1.5rem);
		transform: rotate(-1.5deg);
		box-shadow: 5px 5px 0 var(--schatten);
	}

	.foto {
		all: unset;
		box-sizing: border-box;
		cursor: zoom-in;
		padding: 10px;
		background: var(--papier);
		box-shadow: 0 16px 36px rgb(0 0 0 / 0.5);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.foto:hover,
	.foto:focus-visible {
		transform: rotate(0) scale(1.03);
		z-index: 1;
	}
	.foto:focus-visible {
		outline: 3px solid var(--sonne);
	}
	.foto :global(img) {
		display: block;
	}
	/* Ganzes Foto zeigen, nie zuschneiden; höchstens so hoch wie der Bildschirm */
	.foto.haupt {
		display: block;
		width: fit-content;
		max-width: 100%;
		transform: rotate(calc(var(--r) * 0.35));
	}
	.foto.haupt :global(img) {
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 72vh;
	}
	/* Weitere Fotos, darunter die Videos: je eine Reihe gleich hoher Kacheln. Passt eine Reihe nicht in die Breite,
	   scrollt sie seitlich (auf dem Handy mit Einrasten). Innenabstand, damit gekippte Karten und Schatten nicht abgeschnitten werden. */
	.weitere {
		--hoehe: clamp(220px, 26vw, 300px);
		display: flex;
		flex-wrap: nowrap;
		align-items: flex-start;
		gap: 24px;
		overflow-x: auto;
		margin: -14px -16px;
		padding: 14px 16px 22px;
		scroll-snap-type: x proximity;
	}
	.weitere > * {
		flex: none;
		scroll-snap-align: start;
	}
	.foto.klein :global(img) {
		height: var(--hoehe);
		width: auto;
		max-width: 100%;
		object-fit: cover;
	}
	.handy-platz {
		width: calc(var(--hoehe) * 0.6);
		flex: none;
	}
	/* Quer gedrehtes Handy: gleiche Höhe, entsprechend breiter */
	.handy-platz:has(:global(.handy.quer)) {
		width: calc(var(--hoehe) * 1.7);
	}
	@media (max-width: 759px) {
		.weitere {
			scroll-snap-type: x mandatory;
		}
		/* Ausrichten links, damit rechts schon das nächste Foto hervorschaut */
		.weitere > * {
			scroll-snap-align: start;
		}
		/* Querformat-Fotos nicht bildschirmbreit: rechts schaut das nächste Foto hervor, man sieht, dass es weitergeht */
		.foto.klein {
			max-width: 78vw;
		}
		.foto.klein :global(img) {
			height: calc(var(--hoehe) * 0.92);
		}
	}
</style>
