---
import { Picture, getImage } from 'astro:assets';
import credits from '../assets/fotos/credits.json';
import foto from '../assets/fotos/2025-timmendorf-4.jpg';
import Handy from './Handy.astro';

// Große Fassung für die Lightbox
const gross = (await getImage({ src: foto, width: 1800, format: 'webp' })).src;
const alt = 'Gruppenfoto der Fraktion Bräune im Sand vor der Tribüne, mit Fahnen';

const sticker = [
	{ text: 'Laut 📣', farbe: 'var(--fackel)', r: -6 },
	{ text: 'Bunt 🌈', farbe: 'var(--lila)', r: 4 },
	{ text: 'Immer positiv ☀️', farbe: 'var(--sonne)', r: -3, dunkel: true },
	{ text: 'Bewusst genießen 🥂', farbe: 'var(--gruen)', r: 5, dunkel: true },
];
---

<section class="abschnitt" id="wir">
	<div class="wrap raster">
		<div class="text">
			<h2>Wer ist diese <span class="zusammen"><mark>Fraktion Bräune</mark>?</span></h2>
			<p class="gross">
				Wir sind eine Freundesgruppe, die Beachvolleyball liebt. Seit 2021 reisen wir zu Turnieren und machen auf der
				Tribüne einfach das, was uns am meisten Spaß macht: mitfiebern, mitsingen, mitfeiern.
			</p>
			<p>
				Mit Fahnen, selbstgemalten Bannern, Choreos und Pyro. Wir singen, wir tanzen und feiern jeden Punkt unseres
				Teams. Laut, bunt und immer gut drauf.
			</p>
			<ul class="sticker" role="list">
				{sticker.map((s) => (
					<li style={`--farbe: ${s.farbe}; --r: ${s.r}deg`} class:list={{ dunkel: s.dunkel }}>{s.text}</li>
				))}
			</ul>
		</div>

		<div class="bild">
			<figure class="polaroid">
				<button type="button" class="foto-knopf" data-gross={gross} data-alt={alt} data-credit={credits['2025-timmendorf-4'] ?? ''} aria-label={`Groß anzeigen: ${alt}`}>
					<Picture src={foto} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 480px, 92vw" alt={alt} />
				</button>
				<figcaption class="marker">Timmendorf 2025 · 📸 @{credits['2025-timmendorf-4']}</figcaption>
			</figure>
			<button type="button" class="pokal" aria-haspopup="dialog" aria-label="Fan Group of the Year, GBT Awards 2025: Videos von der Preisverleihung ansehen">
				<span class="pokal-icon" aria-hidden="true">🏆</span>
				<strong>Fan Group<br />of the Year</strong>
				<span class="pokal-klein">GBT Awards 2025</span>
				<span class="pokal-play" aria-hidden="true">▶ Video</span>
			</button>
			<div class="crew">
				<Handy clip="reel-crew" r={-5} />
			</div>
		</div>
	</div>

	<dialog class="award" aria-labelledby="award-titel">
		<div class="award-innen">
			<button type="button" class="zu" aria-label="Schließen">✕</button>
			<h3 id="award-titel">🏆 Fan Group of the Year 2025</h3>
			<div class="award-handys">
				<Handy clip="award25-interview" r={-2} />
				<Handy clip="reel-award-training" r={2} />
			</div>
		</div>
	</dialog>
</section>

<script>
	import { alleAnhalten } from '../scripts/videos';
	const dialog = document.querySelector<HTMLDialogElement>('dialog.award')!;
	document.querySelector('#wir .pokal')!.addEventListener('click', () => dialog.showModal());
	dialog.querySelector('.zu')!.addEventListener('click', () => dialog.close());
	// Klick neben den Inhalt schließt
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
	dialog.addEventListener('close', () => alleAnhalten());
</script>

<style>
	.raster {
		display: grid;
		gap: 56px;
		align-items: center;
	}
	@media (min-width: 900px) {
		.raster {
			grid-template-columns: 1.1fr 0.9fr;
		}
	}
	h2 {
		font-size: clamp(2.4rem, 7vw, 4.4rem);
		line-height: 1.12;
	}
	.zusammen {
		white-space: nowrap;
	}
	mark {
		background: var(--papier);
		color: var(--tinte);
		display: inline-block;
		margin-top: 0.1em;
		padding: 0.04em 0.12em 0;
		line-height: 0.95;
		transform: rotate(-1.5deg);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.gross {
		font-size: clamp(1.25rem, 2.6vw, 1.6rem);
		line-height: 1.4;
		font-weight: 700;
	}
	.text p {
		max-width: 56ch;
	}
	.sticker {
		list-style: none;
		padding: 0;
		margin: 32px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}
	.sticker li {
		font-family: var(--display);
		text-transform: uppercase;
		/* mind. 24 px: ab da reicht Kontrast 3:1 (weiß auf Rot/Lila) */
		font-size: clamp(1.5rem, 3vw, 1.7rem);
		padding: 0.25em 0.8em;
		border-radius: 999px;
		background: var(--farbe);
		color: var(--papier);
		border: 3px solid var(--tinte);
		box-shadow: 4px 4px 0 var(--tinte);
		transform: rotate(var(--r));
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.sticker li.dunkel {
		color: var(--tinte);
	}
	.sticker li:hover {
		transform: rotate(0) scale(1.12);
	}

	.bild {
		position: relative;
		justify-self: center;
		width: min(480px, 100%);
	}
	.polaroid {
		margin: 0;
		padding: 12px 12px 0;
		background: var(--papier);
		color: var(--tinte);
		transform: rotate(3deg);
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.5);
	}
	.foto-knopf {
		all: unset;
		display: block;
		cursor: zoom-in;
	}
	.foto-knopf:focus-visible {
		outline: 3px solid var(--sonne);
		outline-offset: 4px;
	}
	.polaroid :global(img) {
		width: 100%;
		height: auto;
	}
	figcaption {
		padding: 10px 4px 14px;
		font-size: 1.05rem;
	}
	.pokal {
		position: absolute;
		top: -56px;
		left: -40px;
		margin: 0;
		width: clamp(128px, 32vw, 168px);
		aspect-ratio: 1;
		border-radius: 50%;
		display: grid;
		place-content: center;
		justify-items: center;
		text-align: center;
		gap: 2px;
		background: var(--sonne);
		color: var(--tinte);
		border: 4px solid var(--tinte);
		box-shadow: 5px 6px 0 var(--tinte);
		transform: rotate(-10deg);
		transition: transform 0.3s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.pokal {
		font: inherit;
		cursor: pointer;
		padding: 0;
	}
	.pokal:hover,
	.pokal:focus-visible {
		transform: rotate(0) scale(1.08);
	}
	.pokal-play {
		margin-top: 4px;
		font-size: clamp(0.6rem, 1.6vw, 0.75rem);
		font-weight: 800;
		text-transform: uppercase;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: var(--tinte);
		color: var(--sonne);
	}
	.crew {
		width: 170px;
		margin: 40px auto 0;
	}
	@media (min-width: 900px) {
		.crew {
			position: absolute;
			right: -64px;
			bottom: -96px;
			width: 150px;
			margin: 0;
		}
	}
	.award {
		width: min(640px, calc(100vw - 32px));
		max-height: calc(100dvh - 32px);
		padding: 0;
		border: 3px solid var(--tinte);
		border-radius: 24px;
		background: var(--nacht-2);
		color: var(--papier);
		box-shadow: 8px 8px 0 var(--sonne);
	}
	.award::backdrop {
		background: rgb(10 6 12 / 0.8);
	}
	.award-innen {
		position: relative;
		padding: 24px clamp(16px, 4vw, 32px) 32px;
	}
	.award h3 {
		margin: 0 48px 24px 0;
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(1.6rem, 5vw, 2.2rem);
		line-height: 1.05;
	}
	.zu {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 2px solid var(--tinte);
		background: var(--papier);
		color: var(--tinte);
		font-size: 1.2rem;
		cursor: pointer;
	}
	.award-handys {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(16px, 4vw, 32px);
		max-width: 480px;
		margin: 0 auto;
	}
	.pokal-icon {
		font-size: clamp(1.6rem, 5vw, 2.2rem);
		line-height: 1;
	}
	.pokal strong {
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(1rem, 3vw, 1.3rem);
		line-height: 1;
	}
	.pokal-klein {
		font-size: clamp(0.55rem, 1.6vw, 0.72rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		padding: 0 14px;
	}
	@media (max-width: 520px) {
		.pokal {
			left: -8px;
		}
	}
</style>
