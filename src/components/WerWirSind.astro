---
import { Picture } from 'astro:assets';
import credits from '../assets/fotos/credits.json';
import foto from '../assets/fotos/2025-timmendorf-4.jpg';

const sticker = [
	{ text: 'Laut 📣', farbe: 'var(--fackel)', r: -6 },
	{ text: 'Bunt 🌈', farbe: 'var(--lila)', r: 4 },
	{ text: 'Immer positiv ☀️', farbe: 'var(--sonne)', r: -3, dunkel: true },
	{ text: 'Bewusst genießen 🥂', farbe: 'var(--gruen)', r: 5, dunkel: true },
];
---

<section class="abschnitt" id="wir">
	<div class="wrap raster">
		<div class="text">
			<h2>Wer ist diese <span class="zusammen"><mark>Fraktion Bräune</mark>?</span></h2>
			<p class="gross">
				Wir sind eine Freundesgruppe, die seit 2021 zu den Events der German Beach Tour fährt und die Teams im Sand nach
				vorne schreit.
			</p>
			<p>
				Mit Fahnen, selbstgemalten Bannern, Choreos und Pyro. Wir singen, wir tanzen, wir feiern jeden Punkt, und
				zwar für alle auf dem Platz. Laut, bunt und immer gut drauf.
			</p>
			<ul class="sticker" role="list">
				{sticker.map((s) => (
					<li style={`--farbe: ${s.farbe}; --r: ${s.r}deg`} class:list={{ dunkel: s.dunkel }}>{s.text}</li>
				))}
			</ul>
		</div>

		<div class="bild">
			<figure class="polaroid">
				<Picture src={foto} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 480px, 92vw" alt="Gruppenfoto der Fraktion Bräune im Sand vor der Tribüne, mit Fahnen" />
				<figcaption class="marker">Timmendorf 2025 · 📸 @{credits['2025-timmendorf-4']}</figcaption>
			</figure>
			<p class="pokal">
				<span class="pokal-icon" aria-hidden="true">🏆</span>
				<strong>Fan Group<br />of the Year</strong>
				<span class="pokal-klein">GBT Awards 2025</span>
			</p>
		</div>
	</div>
</section>

<style>
	.raster {
		display: grid;
		gap: 56px;
		align-items: center;
	}
	@media (min-width: 900px) {
		.raster {
			grid-template-columns: 1.1fr 0.9fr;
		}
	}
	h2 {
		font-size: clamp(2.4rem, 7vw, 4.4rem);
		line-height: 1.12;
	}
	.zusammen {
		white-space: nowrap;
	}
	mark {
		background: var(--papier);
		color: var(--tinte);
		display: inline-block;
		margin-top: 0.1em;
		padding: 0.04em 0.12em 0;
		line-height: 0.95;
		transform: rotate(-1.5deg);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.gross {
		font-size: clamp(1.25rem, 2.6vw, 1.6rem);
		line-height: 1.4;
		font-weight: 700;
	}
	.text p {
		max-width: 56ch;
	}
	.sticker {
		list-style: none;
		padding: 0;
		margin: 32px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}
	.sticker li {
		font-family: var(--display);
		text-transform: uppercase;
		/* mind. 24 px: ab da reicht Kontrast 3:1 (weiß auf Rot/Lila) */
		font-size: clamp(1.5rem, 3vw, 1.7rem);
		padding: 0.25em 0.8em;
		border-radius: 999px;
		background: var(--farbe);
		color: var(--papier);
		border: 3px solid var(--tinte);
		box-shadow: 4px 4px 0 var(--tinte);
		transform: rotate(var(--r));
		transition: transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.sticker li.dunkel {
		color: var(--tinte);
	}
	.sticker li:hover {
		transform: rotate(0) scale(1.12);
	}

	.bild {
		position: relative;
		justify-self: center;
		width: min(480px, 100%);
	}
	.polaroid {
		margin: 0;
		padding: 12px 12px 0;
		background: var(--papier);
		color: var(--tinte);
		transform: rotate(3deg);
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.5);
	}
	.polaroid :global(img) {
		width: 100%;
		height: auto;
	}
	figcaption {
		padding: 10px 4px 14px;
		font-size: 1.05rem;
	}
	.pokal {
		position: absolute;
		top: -56px;
		left: -40px;
		margin: 0;
		width: clamp(128px, 32vw, 168px);
		aspect-ratio: 1;
		border-radius: 50%;
		display: grid;
		place-content: center;
		justify-items: center;
		text-align: center;
		gap: 2px;
		background: var(--sonne);
		color: var(--tinte);
		border: 4px solid var(--tinte);
		box-shadow: 5px 6px 0 var(--tinte);
		transform: rotate(-10deg);
		transition: transform 0.3s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.pokal:hover {
		transform: rotate(0) scale(1.08);
	}
	.pokal-icon {
		font-size: clamp(1.6rem, 5vw, 2.2rem);
		line-height: 1;
	}
	.pokal strong {
		font-family: var(--display);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(1rem, 3vw, 1.3rem);
		line-height: 1;
	}
	.pokal-klein {
		font-size: clamp(0.55rem, 1.6vw, 0.72rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		padding: 0 14px;
	}
	@media (max-width: 520px) {
		.pokal {
			left: -8px;
		}
	}
</style>
