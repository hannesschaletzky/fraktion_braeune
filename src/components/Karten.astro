---
// Polaroid-Karten für die Startseite (neueste Choreos bzw. Stationen) mit Knopf zur Unterseite
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	karten: { href: string; bild: ImageMetadata; alt: string; datum: string; ort: string; text: string; fokus?: string }[];
	mehr: { href: string; text: string };
}
const { karten, mehr } = Astro.props;
const neigungen = [-2, 1.5, -1];
const farben = ['var(--fackel)', 'var(--gruen)', 'var(--lila)'];
---

<ul class="karten" role="list">
	{karten.map((k, i) => (
		<li style={`--r: ${neigungen[i % 3]}deg; --schatten: ${farben[i % 3]}`}>
			<a href={k.href} class="karte">
				<Picture src={k.bild} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 900px) 340px, 92vw" alt={k.alt} loading="lazy" style={k.fokus ? `object-position: ${k.fokus}` : undefined} />
				<span class="wann">
					<span class="datum">{k.datum}</span>
					<span class="ort">{k.ort}</span>
				</span>
				<span class="text marker">{k.text}</span>
			</a>
		</li>
	))}
</ul>
<a class="alle" href={mehr.href}>{mehr.text}</a>

<style>
	.karten {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 36px 28px;
	}
	@media (min-width: 760px) {
		.karten {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.karte {
		height: 100%;
		box-sizing: border-box;
		display: grid;
		grid-template-rows: auto auto 1fr;
		gap: 12px;
		padding: 10px 10px 16px;
		background: var(--papier);
		color: var(--tinte);
		text-decoration: none;
		box-shadow: 6px 6px 0 var(--schatten);
		transform: rotate(var(--r));
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.karte:hover,
	.karte:focus-visible {
		transform: rotate(0) scale(1.03);
	}
	.karte :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}
	.wann {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 10px;
		padding: 0 4px;
		font-family: var(--display);
		text-transform: uppercase;
		font-size: 1.35rem;
		line-height: 1.05;
	}
	.datum {
		color: #b8860b;
	}
	.text {
		padding: 0 4px;
		font-size: 1rem;
		line-height: 1.3;
	}
	.alle {
		display: inline-block;
		margin-top: 48px;
		padding: 0.7em 1.4em;
		border-radius: 999px;
		border: 3px solid var(--tinte);
		background: var(--sonne);
		color: var(--tinte);
		font-family: var(--display);
		text-transform: uppercase;
		font-size: clamp(1.05rem, 3vw, 1.3rem);
		text-decoration: none;
		box-shadow: 5px 5px 0 var(--tinte);
		transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
	}
	.alle:hover {
		transform: rotate(-2deg) scale(1.05);
	}
</style>
