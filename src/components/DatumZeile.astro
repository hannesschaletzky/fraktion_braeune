---
// Einheitliche Datumszeile „2023 | Jun | Hamburg“ für TV-Programm und Zitate: in der normalen Textschrift,
// klein und grau (anders als die großen Stationsköpfe), damit sie nicht das Auge lenkt.
import { monate } from '../data/stationen';

interface Props {
	jahr: number;
	monat: number;
	ort: string;
	class?: string;
}
const { jahr, monat, ort, class: klasse } = Astro.props;
---

<span class:list={['dz', klasse]}>
	<span class="dz-jahr">{jahr}</span><span class="dz-strich" aria-hidden="true">|</span><span class="dz-monat">{monate[monat - 1].slice(0, 3)}</span><span class="dz-strich" aria-hidden="true">|</span><span class="dz-ort">{ort}</span>
</span>

<style>
	.dz {
		display: block;
		min-width: 0;
		line-height: 1.3;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.dz-strich {
		margin: 0 0.3em;
		opacity: 0.5;
	}
</style>
