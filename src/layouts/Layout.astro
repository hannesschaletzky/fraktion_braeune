---
import '@fontsource/anton';
import '@fontsource/permanent-marker';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import teilenBild from '../assets/teilen.jpg';
import logo from '../assets/logo-bunt.png';
import NachOben from '../components/NachOben.astro';
import Kopfleiste from '../components/Kopfleiste.astro';

interface Props {
	titel?: string;
	beschreibung?: string;
	/** Vorschaubild beim Teilen (WhatsApp, Instagram, Google) */
	bild?: ImageMetadata;
	bildAlt?: string;
	/** Fehlerseiten nicht in die Suche */
	nichtIndexieren?: boolean;
	/** Unterseiten: Kopfleiste von Anfang an mit Hintergrund und Logo */
	unterseite?: boolean;
}
const {
	titel = 'Fraktion Bräune – Europas lauteste Beachvolleyball-Fans',
	beschreibung = 'Wir sind Fraktion Bräune, die Beachvolleyball-Fangruppe aus Berlin auf der German Beach Tour: Fahnen, Choreos, Pyro und gute Laune. Fan Group of the Year 2025.',
	bild = teilenBild,
	bildAlt = 'Fraktion Bräune: unsere Gruppe jubelt vor dem Block an der Bande, dazu unser buntes Logo',
	nichtIndexieren = false,
	unterseite = false,
} = Astro.props;

const site = Astro.site!;
const seite = new URL(Astro.url.pathname, site).href;
// 1200 × 630 zeigen WhatsApp, Facebook und X ohne Beschnitt
const vorschau = await getImage({ src: bild, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const bildUrl = new URL(vorschau.src, site).href;
const logoUrl = new URL((await getImage({ src: logo, width: 600, format: 'png' })).src, site).href;

// Strukturierte Daten: Google erkennt Name, Logo, Instagram-Profil und Auszeichnung
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SportsOrganization',
	name: 'Fraktion Bräune',
	alternateName: 'Fraktion Braeune',
	url: site.href,
	logo: logoUrl,
	image: bildUrl,
	description: 'Beachvolleyball-Fangruppe aus Berlin, unterwegs auf der German Beach Tour.',
	sport: 'Beachvolleyball',
	foundingDate: '2021',
	award: 'Fan Group of the Year – GBT Awards 2025',
	sameAs: ['https://www.instagram.com/fraktion_braeune/'],
};
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titel}</title>
		<meta name="description" content={beschreibung} />
		{nichtIndexieren ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={seite} />}
		<!-- Favicon: Regenbogen in vier Farben (erzeugt von scripts/favicon.mjs) -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#140d16" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Fraktion Bräune" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={titel} />
		<meta property="og:description" content={beschreibung} />
		<meta property="og:url" content={seite} />
		<meta property="og:image" content={bildUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={bildAlt} />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Besucherstatistik ohne Cookies (Plausible auf stats.hschaletzky.com), Skript und Zählung laufen
		     über diese Domain (Caddy leitet /js/pa-* und /api/event weiter). Nur im echten Build, nicht lokal -->
		{import.meta.env.PROD && <script async src="/js/pa-rfqcbaaSlsMgNO7E4cj4a.js"></script>}
		{
			import.meta.env.PROD && (
				<script is:inline>
					window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
					plausible.init({ endpoint: '/api/event' });
				</script>
			)
		}
	</head>
	<body>
		<Kopfleiste fest={unterseite} />
		<slot />
		<NachOben />
	</body>
</html>
