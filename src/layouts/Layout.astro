---
import '@fontsource/anton';
import '@fontsource/permanent-marker';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import foto from '../assets/1.jpg';

interface Props {
	titel?: string;
	beschreibung?: string;
}
const {
	titel = 'Fraktion Bräune – Europas lauteste Beachvolleyball-Fans',
	beschreibung = 'Fahnen, Choreos, Pyro und immer gute Laune: Fraktion Bräune fährt zu den Events der German Beach Tour. Fan Group of the Year 2025.',
} = Astro.props;
const seite = new URL(Astro.url.pathname, Astro.site).href;
const vorschau = await getImage({ src: foto, width: 1200, format: 'jpg' });
const bildUrl = new URL(vorschau.src, Astro.site).href;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{titel}</title>
		<meta name="description" content={beschreibung} />
		<meta name="theme-color" content="#140d16" />
		<link rel="canonical" href={seite} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:title" content={titel} />
		<meta property="og:description" content={beschreibung} />
		<meta property="og:url" content={seite} />
		<meta property="og:image" content={bildUrl} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
